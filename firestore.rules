rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Domain-based check: @eduversal.org emails
    // Defensive: token.email may be absent on some session-restore paths;
    // checking presence first avoids a NoSuchProperty error that would
    // collapse the whole predicate to false.
    function isEduversal() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string &&
             request.auth.token.email.matches('.*@eduversal\\.org$');
    }

    // School teachers - any @*.sch.id Google account (Academic Hub / Teachers Hub)
    function isSchoolUser() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string &&
             request.auth.token.email.matches('.*@.*\\.sch\\.id');
    }

    // Manually-added users sign in via email/password - Firebase sets
    // sign_in_provider = 'password' for these accounts.
    function isEmailPasswordUser() {
      return isSignedIn() &&
             request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Authorized = @eduversal.org domain OR school domain OR manually-added email/password account
    function isAuthorized() {
      return isEduversal() || isSchoolUser() || isEmailPasswordUser();
    }

    // Helper: caller's users/{uid} doc exists. Use this BEFORE userProfile()
    // to avoid throwing on missing-doc reads (which would silently collapse
    // every role check to false → "Missing or insufficient permissions").
    function userProfileExists() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: read the caller's Firestore profile.
    // Callers must guard with userProfileExists() OR rely on the per-role
    // helpers below (isAdmin, isTeachersUser, etc.) which already guard.
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthorized() && userProfileExists()
             && userProfile().role_centralhub == 'central_admin';
    }

    // ── Approval enforcement (2026-08-01 pre-launch hardening) ──
    // auth-guard auto-provisions role_*hub on first sign-in, so the role
    // field alone proves nothing — before this gate, an unapproved (or
    // rejected) account could bypass the /waiting screen with raw SDK
    // calls and reach everything the role granted. Non-admin hub users
    // now count ONLY once central_admin has flipped their approval to
    // 'approved'. Missing field = NOT approved (auth-guard already
    // treats missing as pending client-side; the 2026-05-20 backfill
    // stamped all pre-gate users 'approved'). *_admin roles bypass —
    // same convention as the client-side gate.
    function chApproved() {
      return ('approval_status_centralhub' in userProfile())
             && userProfile().approval_status_centralhub == 'approved';
    }
    function ahApproved() {
      return ('approval_status_academichub' in userProfile())
             && userProfile().approval_status_academichub == 'approved';
    }
    function thApproved() {
      return ('approval_status_teachershub' in userProfile())
             && userProfile().approval_status_teachershub == 'approved';
    }

    // isCHCoordinator: name kept for back-compat across the ~30 callsites
    // that pre-date the 2026-05-20 role architecture flattening. Now means
    // "any signed-in APPROVED central_user (sub-role-agnostic)" —
    // page-access is the sole authorization gate; rules trust that gate.
    // Director, coordinator, and plain central_user all match.
    // central_admin matches isAdmin() and is OR'd separately by callsites.
    function isCHCoordinator() {
      return isAuthorized() && userProfileExists() &&
             userProfile().role_centralhub == 'central_user' &&
             chApproved();
    }

    // CentralHub Subject Specialist: a central_user whose ch_subjects[]
    // intersects the given list. Used by *_pacing rules so a Math
    // Specialist can write math_pacing but not biology_pacing.
    // Subject keys (11-value enum, canonical list in
    // Central Hub/partials/subject-config.js SUBJECTS):
    //   'math', 'biology', 'chemistry', 'physics', 'science', 'english',
    //   'bahasa', 'religion', 'edu_steam', 'early_years', 'civics'.
    // ('edu_steam' = Edu-STEAM, 'civics' = Civic Education / PPKn — keep
    // the underscore form, never 'steam'.) Empty array on the user = no
    // specialty (cannot write any subject's pacing — must be admin or
    // coordinator instead). Pass an array (e.g. ['biology','chemistry',
    // 'physics'] for combined-science pacing) to allow any matching
    // specialist. NOTE: this helper does NOT hard-validate the enum — it
    // only intersects against the caller-supplied list; the enum above is
    // documentation, the authoritative list lives in subject-config.js.
    function isCHSubjectSpecialist(subjects) {
      return isAuthorized() && userProfileExists()
             && (userProfile().role_centralhub == 'central_admin'
                 || (userProfile().role_centralhub == 'central_user'
                     && chApproved()))
             && ('ch_subjects' in userProfile())
             && userProfile().ch_subjects is list
             && userProfile().ch_subjects.hasAny(subjects);
    }

    // Academic Hub admin: central_admin or academic_admin can create/edit/delete AH content
    function isAHAdmin() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_centralhub  == 'central_admin'  ||
        userProfile().role_academichub == 'academic_admin'
      );
    }

    function isModerator() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_centralhub  == 'central_admin'  ||
        userProfile().role_academichub == 'academic_admin' ||
        (userProfile().role_academichub == 'academic_user' && ahApproved())
      );
    }

    function isCentralUser() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_centralhub == 'central_admin' ||
        (userProfile().role_centralhub == 'central_user' && chApproved())
      );
    }

    // CH director sub-role check. Used by principal_coaching_sessions
    // for coaching confidentiality (Principal Coaching Framework →
    // data_model.access_control) — only HQ Directors
    // mentor principals; coordinator + plain central_user cannot write
    // coaching sessions even if the page-access doc lets them open the
    // form. admin always bypasses.
    function isCHDirector() {
      return isCentralUser() && (
        userProfile().role_centralhub == 'central_admin' ||
        ('ch_sub_roles' in userProfile() && 'director' in userProfile().ch_sub_roles)
      );
    }

    function isAcademicUser() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_academichub == 'academic_admin' ||
        (userProfile().role_academichub == 'academic_user' && ahApproved())
      );
    }

    function isTeachersUser() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_teachershub == 'teachers_admin' ||
        (userProfile().role_teachershub == 'teachers_user' && thApproved())
      );
    }

    function isTHAdmin() {
      return isAuthorized() && userProfileExists() && (
        userProfile().role_centralhub  == 'central_admin' ||
        userProfile().role_teachershub == 'teachers_admin'
      );
    }

    // Students Hub — student profiles live in `students/{uid}`, NOT in
    // `users/{uid}`. There is no role / sub-role / approval field; instead a
    // `status` field gates access. Helpers below are used by the Students
    // Hub block AND any future Phase-2 chapter_test_* / ease_* collections
    // that need same-school / same-class scoping.
    function studentDocExists() {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    function studentDoc() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }
    function isActiveStudent() {
      return isSignedIn() && studentDocExists() && studentDoc().status == 'active';
    }

    function canAccessPlatform(platform) {
      return (
        (platform == 'centralhub'  && isCentralUser()) ||
        (platform == 'academichub' && isAcademicUser()) ||
        (platform == 'teachershub' && isTeachersUser())
      );
    }

    function surveyHasPlatform(surveyData, platform) {
      return (
        (
          ('platforms' in surveyData) &&
          surveyData.platforms is list &&
          surveyData.platforms.hasAny([platform])
        ) ||
        (
          !('platforms' in surveyData) &&
          platform == 'centralhub'
        )
      );
    }

    function canReadSurvey(surveyData) {
      return isAdmin() || (
        isAuthorized() && (
          (surveyHasPlatform(surveyData, 'centralhub')  && isCentralUser()) ||
          (surveyHasPlatform(surveyData, 'academichub') && isAcademicUser()) ||
          (surveyHasPlatform(surveyData, 'teachershub') && isTeachersUser())
        )
      );
    }

    function surveyExists(surveyId) {
      return exists(/databases/$(database)/documents/surveys/$(surveyId));
    }

    function surveyData(surveyId) {
      return get(/databases/$(database)/documents/surveys/$(surveyId)).data;
    }

    function surveyIsOpenForResponses(surveyId) {
      return (
        surveyExists(surveyId) &&
        canReadSurvey(surveyData(surveyId)) &&
        (
          !('status' in surveyData(surveyId)) ||
          surveyData(surveyId).status == 'published'
        ) &&
        (
          !('allowResponses' in surveyData(surveyId)) ||
          surveyData(surveyId).allowResponses == true
        )
      );
    }

    function isValidResponsePayload(data) {
      return (
        data.userId == request.auth.uid &&
        data.surveyId is string &&
        data.platform is string &&
        data.answers is list &&
        data.platform in ['centralhub', 'academichub', 'teachershub'] &&
        canAccessPlatform(data.platform) &&
        surveyIsOpenForResponses(data.surveyId) &&
        surveyHasPlatform(surveyData(data.surveyId), data.platform)
      );
    }

    // ── users/{uid} self-write clamp helpers (2026-08-01 hardening) ──
    // The pre-launch security audit found the old blanket self-write
    // (`request.auth.uid == uid`) let ANY user set their own role_*hub /
    // *_sub_roles / approval_status_* via raw SDK — a full privilege
    // escalation that invalidated every role-based rule in this file
    // (same class as the 2026-05-05 AH self-promotion incident).
    // The clamp keeps every legitimate self-service path (first-login
    // provisioning, staff-bridge prefill, settings/profile edits,
    // read-markers, TH teaching-profile dynamic fields) while making
    // privilege-bearing fields admin-only after first declaration:
    //   - role_*hub          → self-set ONLY while absent AND to the
    //                          non-admin default (cross-hub provisioning
    //                          on first visit to a hub).
    //   - approval_status_*  → self-set ONLY while absent AND to
    //                          'pending' — never to 'approved'.
    //   - ah/th_sub_roles    → one-time self-declare at the signup
    //                          prompt (stored value absent or []);
    //                          afterwards CH /console only.
    //   - schoolId / school  → one-time while schoolId is unset (profile
    //                          prompt / staff bridge); afterwards
    //                          CH /console only.
    //   - ch_sub_roles / ch_subjects / appraisal_level* / email / uid
    //                        → never self-writable.
    function usersSelfDiffKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function selfFieldFirstSetOnly(field, allowedVal) {
      return !usersSelfDiffKeys().hasAny([field])
             || (!(field in resource.data)
                 && request.resource.data[field] == allowedVal);
    }
    function selfOneTimeListDeclare(field) {
      return !usersSelfDiffKeys().hasAny([field])
             || !(field in resource.data)
             || resource.data[field] == [];
    }
    function selfSchoolStillUnset() {
      return !usersSelfDiffKeys().hasAny(['schoolId', 'school'])
             || !('schoolId' in resource.data)
             || resource.data.schoolId == null
             || resource.data.schoolId == '';
    }

    // -- users -----------------------------------------------
    match /users/{uid} {
      // Any signed-in user can read their own doc
      // (covers school-domain Teachers Hub / Academic Hub users logging in via Google)
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // List (collection query) for CentralHub console (central_admin),
      // AH appraisal teacher search, and CH coordinators who need to view
      // per-teacher pacing progress.
      //
      // AH school leadership (FR / SP / AC / CC) is included because the
      // appraisal + walkthrough entry pages let a principal pick the teacher
      // they are appraising. Previously only academic_admin could run this
      // query, so a school_principal hit "Missing or insufficient permissions"
      // and the teacher picker stayed empty. `list` cannot inspect the matched
      // docs, so the school scope is enforced by the client query
      // (where('schoolId','==',<own school>)) rather than here.
      allow list:   if isAdmin() || isAHAdmin() || isCHCoordinator()
                       || isAHSchoolLeaderAnySchool();

      allow delete: if isAdmin();

      // Self-CREATE: first sign-in provisioning (auth-guard / login pages).
      // Role + approval fields pinned to non-privileged defaults; identity
      // fields pinned to the auth token; CH privilege fields banned.
      allow create: if isAdmin() ||
        (isSignedIn()
         && request.auth.uid == uid
         && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
         && (!('email' in request.resource.data)
             || request.resource.data.email == request.auth.token.email)
         && (!('role_centralhub' in request.resource.data)
             || request.resource.data.role_centralhub == 'central_user')
         && (!('role_academichub' in request.resource.data)
             || request.resource.data.role_academichub == 'academic_user')
         && (!('role_teachershub' in request.resource.data)
             || request.resource.data.role_teachershub == 'teachers_user')
         && (!('role_researchhub' in request.resource.data)
             || request.resource.data.role_researchhub == 'research_user')
         && (!('approval_status_centralhub' in request.resource.data)
             || request.resource.data.approval_status_centralhub == 'pending')
         && (!('approval_status_academichub' in request.resource.data)
             || request.resource.data.approval_status_academichub == 'pending')
         && (!('approval_status_teachershub' in request.resource.data)
             || request.resource.data.approval_status_teachershub == 'pending')
         && !request.resource.data.keys().hasAny([
              'ch_sub_roles', 'ch_subjects', 'ch_phase',
              'appraisal_level', 'appraisal_level_setAt', 'appraisal_level_setBy'
            ]));

      // Self-UPDATE: everything EXCEPT privilege-bearing fields (see the
      // clamp helper comment above the match block).
      allow update: if isAdmin() ||
        (isSignedIn()
         && request.auth.uid == uid
         && !usersSelfDiffKeys().hasAny([
              'ch_sub_roles', 'ch_subjects', 'ch_phase', 'email', 'uid',
              'appraisal_level', 'appraisal_level_setAt', 'appraisal_level_setBy'
            ])
         && selfFieldFirstSetOnly('role_centralhub',  'central_user')
         && selfFieldFirstSetOnly('role_academichub', 'academic_user')
         && selfFieldFirstSetOnly('role_teachershub', 'teachers_user')
         && selfFieldFirstSetOnly('role_researchhub', 'research_user')
         && selfFieldFirstSetOnly('approval_status_centralhub',  'pending')
         && selfFieldFirstSetOnly('approval_status_academichub', 'pending')
         && selfFieldFirstSetOnly('approval_status_teachershub', 'pending')
         && selfOneTimeListDeclare('ah_sub_roles')
         && selfOneTimeListDeclare('th_sub_roles')
         && selfSchoolStillUnset());

      // Narrow extra path: a school_principal / academic_coordinator may set
      // ONLY the appraisal level, and ONLY for a teacher at their own school.
      // The level decides which F2 Class Observation items are in scope
      // (30 at Induction up to 45 at Lead), so the school that runs the
      // appraisal needs to be able to correct it without going through HQ.
      //
      // Deliberately tight — this is a second write path into `users`, the
      // collection that also holds every role field:
      //   - affectedKeys is pinned to the level + its two audit fields, so a
      //     leader cannot touch role_*, schoolId, approval_status_* or anything
      //     else in the same update (the 2026-05-05 AH self-promotion incident).
      //   - the target must already be a Teachers Hub user at the same school,
      //     checked against the STORED doc so the schoolId cannot be rewritten
      //     in the same call.
      //   - setBy is pinned to the caller, so the audit trail cannot be forged.
      allow update: if isAcademicUser()
                    && userProfile().ah_sub_roles is list
                    && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator'])
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['appraisal_level', 'appraisal_level_setAt', 'appraisal_level_setBy'])
                    && resource.data.schoolId == userProfile().schoolId
                    && resource.data.schoolId != null
                    && resource.data.role_teachershub in ['teachers_user', 'teachers_admin']
                    && request.resource.data.appraisal_level
                         in ['induction', 'developing', 'proficient', 'lead', null]
                    && request.resource.data.appraisal_level_setBy == request.auth.uid;
    }

    // -- staff -----------------------------------------------
    // Two self-managed paths so auth-guard.js can keep staff/ in sync
    // with first logins, even for users HQ never seeded:
    //   - Self-CREATE: a signed-in user may create the staff doc that
    //     would match their own email. Doc id must be deterministic
    //     (sha1(emailLower).slice(0,20) — auth-guard computes this),
    //     emailLower must match auth.token.email, and userId must
    //     equal auth.uid. Source field locks the row to the
    //     'auth-guard-autocreate' provenance so the seed pipeline
    //     can still distinguish CSV-imported rows.
    //   - Self-UPDATE (link-back): on first login against an
    //     HQ-seeded row, write userId/linkedAt/invited only.
    // Everything else stays admin-only.
    match /staff/{staffId} {
      allow read:   if isAuthorized();
      allow delete: if isAdmin();
      allow create: if isAdmin() ||
        (isSignedIn()
         && request.resource.data.emailLower == request.auth.token.email.lower()
         && request.resource.data.userId == request.auth.uid
         && request.resource.data.source == 'auth-guard-autocreate');
      allow update: if isAdmin() ||
        (isSignedIn()
         && resource.data.emailLower == request.auth.token.email.lower()
         && request.resource.data.userId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userId', 'linkedAt', 'invited']));
    }

    // -- students --------------------------------------------
    // Students Hub user profile collection. Distinct from `users/{uid}`,
    // which is exclusively for staff/HQ across CH/AH/TH.
    //
    // Self-managed paths (so first-login + class-picker work without
    // admin intervention):
    //   - Self-CREATE: a student creates the doc with their own uid as the
    //     doc id. The uid field, email/emailLower, and status='needs_class'
    //     are pinned by the rule so a student can't bootstrap themselves
    //     into 'active' or impersonate another uid.
    //   - Self-UPDATE (class picker): when the doc's current status is
    //     'needs_class', the student may flip status to 'pending_approval'
    //     and write schoolId/classId/className/gradeLevel/classPickedAt.
    //     No other status transition is self-writable — teachers/admin
    //     handle pending_approval → active|rejected and active → graduated.
    //   - Self-UPDATE (lastLoginAt): touch lastLoginAt on every login,
    //     no other field changes allowed.
    //
    // Reads:
    //   - Self: a student can read their own doc.
    //   - Admin: central_admin, teachers_admin, AH admin can read all.
    //   - Same-school AH leadership (school_principal /
    //     academic_coordinator / cambridge_coordinator): reads only
    //     students at their own school. Powers AH /student-roster.
    //   - Same-school TH staff (subject_teacher / subject_leader):
    //     reads only students at their own school. Powers TH
    //     /student-approvals + per-class views.
    //
    // `list` cannot inspect the target doc's schoolId, so it gates on
    // role + sub-role only and trusts the client to pass a
    // `where('schoolId','==',ownSchool)` filter. Same trust-the-filter
    // pattern as `chapter_test_attempts.list` / `weekly_progress.list`.
    // `get` enforces the same-school constraint per-doc.
    match /students/{uid} {
      allow get:    if isSignedIn() && (
                         request.auth.uid == uid
                         || isAdmin() || isAHAdmin() || isTHAdmin()
                         || (isAcademicUser()
                             && userProfile().schoolId == resource.data.schoolId
                             && 'ah_sub_roles' in userProfile()
                             && userProfile().ah_sub_roles is list
                             && userProfile().ah_sub_roles.hasAny(['school_principal','academic_coordinator','cambridge_coordinator']))
                         || isTeacherAtSchool(resource.data.schoolId)
                       );
      allow list:   if isAdmin() || isAHAdmin() || isTHAdmin()
                       || (isAcademicUser()
                           && 'ah_sub_roles' in userProfile()
                           && userProfile().ah_sub_roles is list
                           && userProfile().ah_sub_roles.hasAny(['school_principal','academic_coordinator','cambridge_coordinator']))
                       || (isTeachersUser()
                           && 'th_sub_roles' in userProfile()
                           && userProfile().th_sub_roles is list
                           && userProfile().th_sub_roles.hasAny(['subject_teacher','subject_leader']));
      allow delete: if isAdmin();

      // Self-CREATE on first login. uid pinned, emailLower pinned.
      // Real students start in `needs_class`. HQ Specialists signing
      // into SH to QA the runners (@eduversal.org domain) skip the
      // class-picker flow entirely — they self-create directly into
      // `active` with `is_hq_observer:true`. The domain check is
      // verified server-side from the auth token, so a regular student
      // can't claim observer status by writing the field on their own
      // doc — the rule rejects them outright.
      allow create: if isAdmin() ||
        (isSignedIn()
         && request.auth.uid == uid
         && request.resource.data.uid == uid
         && request.resource.data.emailLower == request.auth.token.email.lower()
         && (
           // Real student path
           request.resource.data.status == 'needs_class'
           ||
           // HQ observer fast-path
           ( request.resource.data.status == 'active'
             && request.resource.data.is_hq_observer == true
             && request.auth.token.email.lower().matches('.*@eduversal\\.org$') )
         ));

      // Self-UPDATE: class picker (needs_class → pending_approval) OR lastLoginAt touch.
      // Admin / TH admin / AH admin can update freely (including approving).
      allow update: if isAdmin() || isAHAdmin() || isTHAdmin() ||
        (isSignedIn() && request.auth.uid == uid && (
          // Class picker transition
          ( resource.data.status == 'needs_class'
            && request.resource.data.status == 'pending_approval'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.emailLower == resource.data.emailLower
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['schoolId','school','classId','className','gradeLevel',
                           'status','classPickedAt'])
          ) ||
          // Login touch
          ( request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastLoginAt','displayName','photoURL'])
          ) ||
          // HQ observer back-fill — promote an @eduversal.org account
          // whose pre-observer doc was created before the fast-path
          // existed. Status flips to 'active' + is_hq_observer flag set
          // in the same touch. Real students can't reach this branch
          // because the token email domain check rejects them.
          ( request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastLoginAt','displayName','photoURL','is_hq_observer','status'])
            && request.resource.data.is_hq_observer == true
            && request.resource.data.status == 'active'
            && request.auth.token.email.lower().matches('.*@eduversal\\.org$')
          ) ||
          // Avatar customization (SH /avatar page, 2026-05-13)
          // Cosmetic only — never reaches assessment scoring. Style
          // is constrained to a fixed allowlist; seed is free-form
          // string (DiceBear accepts anything).
          ( request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['avatarStyle','avatarSeed','avatarUpdatedAt'])
            && (
              !('avatarStyle' in request.resource.data) ||
              request.resource.data.avatarStyle in [
                'bottts','adventurer','lorelei','notionists','shapes','fun-emoji'
              ]
            )
          )
        ));
    }

    // -- chapter_tests ---------------------------------------
    // Network-uniform chapter mastery tests authored by HQ Subject
    // Specialists. Items live in a subcollection.
    //
    // - Read: any authorised staff (CH/AH/TH) for browsing + scheduling;
    //   active students may read PUBLISHED tests so the test runner can
    //   load the test definition for an attempt they own. Drafts are
    //   hidden from students.
    // - Items subcollection: same read scope; active students read items
    //   only when their attempt is in_progress / submitted (they need
    //   stems to take the test and to see their report).
    // - Write: central_admin OR CH coordinator OR CH director (subject
    //   specialty filter is applied client-side; rule keeps gate simple).
    match /chapter_tests/{testId} {
      allow get: if isAuthorized() ||
                    (isActiveStudent() && resource.data.status == 'published');
      allow list: if isAuthorized();
      allow create, update, delete: if isAdmin() || isCHCoordinator();

      // DEPRECATED subcollection (2026-05-11 migration). New items live in
      // top-level chapter_test_items; chapter_tests.itemIds[] holds refs.
      // Block kept for read-fallback during migration window — drop in next sprint.
      match /items/{itemId} {
        allow get: if isAuthorized() || isActiveStudent();
        allow list: if isAuthorized() || isActiveStudent();
        allow create, update, delete: if isAdmin() || isCHCoordinator();
      }
    }

    // -- chapter_test_items (TOP-LEVEL, 2026-05-11) ----------
    // Standalone bank of chapter test items. A chapter_tests doc
    // references items via its itemIds[] field. An item can appear in
    // multiple tests (reuse) and survives test deletion.
    //
    // - Read: any authorised staff. Active students read items referenced
    //   by a published chapter_tests they are taking (UI loads via
    //   `documentId() in itemIds` query — rule does not need to validate
    //   the join, since student-side reads are bounded by attempt doc).
    // - Write: central_admin OR CH coordinator. Same gate as authoring UI.
    // - Versioning: editing an in-use item should bump version + write a
    //   new doc; the rule does not enforce this — UI does.
    match /chapter_test_items/{itemId} {
      function isObserverStudent() {
        return isSignedIn()
               && exists(/databases/$(database)/documents/students/$(request.auth.uid))
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.is_hq_observer == true
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
      }
      allow get, list: if isAuthorized() || isActiveStudent();
      // Authoring (create / update) open to admin + CH coordinator;
      // delete restricted to admin only — coordinators can author
      // and archive but not erase. Mirrors the ease_items policy
      // (2026-05-12) so the two banks share the same boundary.
      // Observer back-write for endorsement denormalisation —
      // endorseCount + endorsedBy only.
      allow update: if isAdmin() || isCHCoordinator() ||
        ( isObserverStudent()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['endorseCount', 'endorsedBy']) );
      allow create: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // Reusable diagram pool — images attached to one or more
    // chapter_test_items (and, later, ease_items / direct
    // /diagrams gallery). Migrated 2026-05-12 from IGCSE Tools'
    // `diagramPool` collection (463 entries: 448 biology + 15 math).
    // Read open to all authorised staff (diagrams render inside
    // chapter test attempts via the bank UI and inside the gallery
    // page). Create/update open to admin + CH coordinator (mirrors
    // chapter_test_items authoring boundary); delete admin-only.
    // Storage rule for the actual binaries lives in storage.rules
    // under `match /diagrams/{subjectId}/{filename}`.
    match /chapter_test_diagrams/{diagramId} {
      allow get, list: if isAuthorized() || isActiveStudent();
      allow create, update: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // Append-only audit trail for destructive chapter_test_items
    // operations. Same shape + lifecycle as ease_items_audit:
    // written client-side inside the same writeBatch as the delete
    // so the record can't go missing if the delete commits.
    // `'import'` action covers bulk seeding from external sources
    // (IGCSE Tools past-paper migration 2026-05-12 onwards) — these
    // are written by admin SDK scripts via service account, the rule
    // still applies if a future UI ever creates an `'import'` audit.
    match /chapter_test_items_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.action in ['delete', 'bulk_delete', 'restore', 'create', 'update', 'import'];
      allow update, delete: if false;
    }

    // -- practice_questions (2026-05-12) ---------------------
    // Supplemental, curriculum-adjacent bank. NOT wired into the
    // formal assessment flow — kept separate from chapter_test_items
    // (network-uniform formal bank) and ease_items (calibrated EASE
    // growth bank). Today populated entirely by the IGCSE Tools
    // ExamView import (Pearson Pre-Algebra / Algebra / Geometry /
    // Pre-Calculus textbook chapters, math only). Future imports of
    // other ExamView decks land here too.
    //
    // Intended use is SH-side tournaments / leaderboards / daily-
    // challenge gamification. Active students need read access so the
    // gamification UI can pull items directly. Authoring boundary
    // mirrors chapter_test_items + ease_items: admin + CH coordinator
    // for create/update, delete admin-only.
    //
    // Public unauth read is intentionally OFF (despite some upstream
    // questions carrying isPublic) — Pearson textbook origin is pilot-
    // internal only. Active-student is the lowest read tier.
    match /practice_questions/{itemId} {
      function isObserverStudent() {
        return isSignedIn()
               && exists(/databases/$(database)/documents/students/$(request.auth.uid))
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.is_hq_observer == true
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
      }
      allow get, list: if isAuthorized() || isActiveStudent();
      // Observer back-write for endorsement denormalisation — pure
      // increment/decrement on endorseCount + arrayUnion/Remove on
      // endorsedBy. Any other field change still requires admin /
      // coordinator. Rule does NOT verify the count delta — that's
      // best-effort denormalisation; a Cloud Function backfill could
      // periodically re-derive from practice_question_endorsements.
      allow update: if isAdmin() || isCHCoordinator() ||
        ( isObserverStudent()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['endorseCount', 'endorsedBy']) );
      allow create: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // Append-only audit trail for practice_questions operations.
    // Same lifecycle as chapter_test_items_audit / ease_items_audit:
    // written client-side (or by admin-SDK migration scripts) inside
    // the same writeBatch as the action so the record can't go
    // missing. The 'import' action covers bulk seeding from external
    // sources (IGCSE Tools ExamView migration onwards).
    match /practice_questions_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.action in ['delete', 'bulk_delete', 'restore', 'create', 'update', 'import', 'flag', 'unflag'];
      allow update, delete: if false;
    }

    // -- practice_assessments (2026-05-12) -------------------
    // HQ-composed bundles of practice_questions items, intended for
    // Students Hub tournaments / leaderboards / daily-challenge
    // gamification. itemIds[] reference practice_questions (no
    // cloning — practice_questions is reuse-safe). NEVER feeds
    // chapter_mastery or ease_growth (formal assessment boundary
    // — see CLAUDE.md Common Mistake #33).
    //
    // - Read: any authorised CH/AH/TH user OR active student when
    //   status == 'published' (so SH gamification surfaces can list
    //   them without granting unauth read).
    // - Create/update: admin OR CH coordinator/director.
    // - Delete: admin only.
    match /practice_assessments/{assessmentId} {
      allow get: if isAuthorized()
                 || (isActiveStudent() && resource.data.status == 'published');
      allow list: if isAuthorized()
                  || isActiveStudent();
      allow create, update: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // Append-only audit log for practiceBankAiSuggest Cloud
    // Function calls. Lets HQ inspect AI cost + which intents are
    // useful. Cloud Function writes; clients read for HQ audit UI.
    match /practice_ai_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if false; // Cloud Function only (admin SDK)
      allow update, delete: if false;
    }

    // AI suggestion cache. 24h soft-TTL. Cache key embeds a
    // fingerprint of the candidate-pool ids so a new import or
    // archive automatically invalidates downstream cached suggestions.
    // Client never reads/writes — Cloud Function only.
    match /ai_suggestion_cache/{cacheId} {
      allow read, write: if false;
    }

    // ── ASK EDUVERSAL (RAG Q&A agent) ───────────────────────
    // Corpus + retrieval index live in Firestore; seeded by
    // scripts/ask/seed-ask-chunks.js (Admin SDK — bypasses these rules).
    // The askEduversal Cloud Function reads chunks/meta with the Admin
    // SDK too; the client only needs read for the KPI + deep-links.
    // See docs/architecture/ASK-EDUVERSAL-RETRIEVAL-SUBPLAN.md.

    // ask_chunks — full-text + embedding per retrieval chunk.
    // Read by signed-in central_user (page KPI; the function uses Admin
    // SDK). Write seed/CF only (Admin SDK). Never client-writable —
    // embeddings + grounding integrity must not be client-mutable.
    match /ask_chunks/{chunkId} {
      allow read:  if isCentralUser();
      allow write: if false;
    }

    // ask_meta/current — corpus fingerprint + chunk count (cache key +
    // page KPI). Read signed-in central_user; write seed/CF only.
    match /ask_meta/{docId} {
      allow read:  if isCentralUser();
      allow write: if false;
    }

    // ask_cache — 24h answer cache keyed on (question + corpus
    // fingerprint). Cloud Function only, like ai_suggestion_cache.
    match /ask_cache/{cacheId} {
      allow read, write: if false;
    }

    // ask_audit — append-only cost/quality log across ALL users.
    // Created by the Cloud Function (Admin SDK). Admin reads for review.
    match /ask_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ask_threads/{uid}/turns — each user's OWN saved Q&A history.
    // A user reads + writes ONLY their own thread; admin may read for
    // support. The answer the client writes here was already produced +
    // audited server-side by askEduversal (the client mirrors it for the
    // user's personal history — it is not a trust boundary for content).
    match /ask_threads/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      match /turns/{turnId} {
        allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // -- scheduled_sessions ----------------------------------
    // A teacher schedules a published chapter_test for one of their
    // classes. Each session writes N draft chapter_test_attempts (one
    // per active student in the class) at create time via a batched
    // write from the launcher page.
    //
    // - Read: any authorised staff; active students read sessions for
    //   their own school+class so the dashboard can show schedule cards.
    // - Create/update/delete: admin OR teachers_admin OR teachers_user
    //   with a subject_teacher / subject_leader sub-role at the same
    //   school as the session's schoolId.
    function isTeacherAtSchool(schoolId) {
      return isAuthorized() && userProfileExists()
             && userProfile().schoolId == schoolId
             && (
               userProfile().role_teachershub == 'teachers_admin'
               || (userProfile().role_teachershub == 'teachers_user'
                   && 'th_sub_roles' in userProfile()
                   && userProfile().th_sub_roles is list
                   && userProfile().th_sub_roles.hasAny(['subject_teacher','subject_leader']))
             );
    }
    match /scheduled_sessions/{sessionId} {
      allow get, list: if isAuthorized() ||
                          (isActiveStudent()
                           && studentDoc().schoolId == resource.data.schoolId
                           && studentDoc().className == resource.data.className);
      allow create: if isAdmin() ||
                       (isTeacherAtSchool(request.resource.data.schoolId)
                        && request.resource.data.teacherUid == request.auth.uid);
      allow update: if isAdmin() ||
                       (isTeacherAtSchool(resource.data.schoolId)
                        && resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // -- chapter_test_attempts -------------------------------
    // Per-student attempt record. Doc id pattern: {sessionId}_{studentUid}.
    //
    // - Read: owner (student) · any same-school staff · admin.
    // - Create: ONLY at session schedule time, by the teacher running
    //   the launcher (must match session.teacherUid). Admin can also
    //   create. Students CANNOT create their own attempts — that would
    //   bypass class membership checks.
    // - Update: owner can write responses while in_progress within the
    //   time window, and submit (status → submitted/scored). Once
    //   submitted, the doc is IMMUTABLE for students. Teacher / admin
    //   can update freely (regrading flagged essays in Phase 2).
    match /chapter_test_attempts/{attemptId} {
      allow get: if isAuthorized() ||
                    (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if isAuthorized();

      allow create: if isAdmin() ||
                       (isTeacherAtSchool(request.resource.data.schoolId)
                        && request.resource.data.studentUid != null);

      // Student self-update: only on their own attempt, only while in
      // an active in_progress / draft state, only writing the answer
      // payload + status flip to submitted/scored.
      allow update: if isAdmin() || isTeacherAtSchool(resource.data.schoolId) ||
        (isSignedIn() && resource.data.studentUid == request.auth.uid
         && resource.data.status in ['draft', 'in_progress']
         && request.resource.data.studentUid == resource.data.studentUid
         && request.resource.data.testId == resource.data.testId
         && request.resource.data.sessionId == resource.data.sessionId
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','startedAt','submittedAt','responses',
                        'rawScorePct','earnedMarks','totalMarks','passed',
                        'autoSubmit','tabSwitches','lockdownEvents','updatedAt']));

      allow delete: if isAdmin();
    }

    // -- chapter_mastery ------------------------------------
    // Denormalised aggregate written by Cloud Function
    // onChapterAttemptWritten. One doc per (student, subject, unit)
    // holds the latest score + mastery band so pacing dashboards +
    // class-assessment heatmaps can read mastery without scanning
    // attempts. Doc id pattern: {studentUid}_{subjectId}_{unitCode},
    // sanitised lowercase.
    //
    // Read: owner (student) · same-school staff · admin.
    // Write: Cloud Function only (admin SDK bypasses rules). No
    // client-side write path — keeps the aggregate canonical.
    match /chapter_mastery/{masteryId} {
      allow get: if isAuthorized() ||
                    (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if isAuthorized();
      allow create, update, delete: if isAdmin();
    }

    // -- EASE Growth (Phase 2 adaptive cross-grade engine) ---
    // Math/English/Science only, 3 windows/year (Term 1 / Term 2 / Term 3).
    // Network-uniform — every partner school's students draw from the
    // same item bank. Items have an author-assigned 3-band difficulty
    // (easy/medium/hard) until enough live response data lets us
    // calibrate logits in a Phase-3 Cloud Function batch job.
    //
    // Six collections:
    //   ease_items/{itemId}        — item bank (admin/coordinator write)
    //   ease_test_windows/{wId}    — Term 1 / Term 2 / Term 3 open windows
    //   ease_sessions/{sId}        — one student × one subject × one window
    //   ease_responses/{rId}       — adaptive trail rows (immutable)
    //   ease_growth/{uid}_{subj}   — cross-window aggregate
    //   parent_share_tokens/{tok}  — token-gated read of one report
    //
    // Read scopes:
    //   - items: any authorised staff for review; active students read
    //     only the next item picked for their session (one at a time).
    //     For MVP simplicity students read all items for their subject;
    //     exposure capping comes in Phase 3.
    //   - sessions / responses: owner (student) + same-school staff
    //     + admin. Responses are immutable once written.
    //   - growth: owner + same-school staff + admin (no student listing
    //     across schools — students see only own).
    //   - parent_share_tokens: anyone with the token gets the read
    //     (rule allows by id), but never list.
    match /ease_items/{itemId} {
      function isObserverStudent() {
        return isSignedIn()
               && exists(/databases/$(database)/documents/students/$(request.auth.uid))
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.is_hq_observer == true
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
      }
      allow get, list: if isAuthorized() || isActiveStudent();
      // Authoring (create / update) open to admin + CH coordinator
      // (subject specialists). Delete is admin-only — coordinators
      // can edit but not erase items from the bank. Item deletion
      // is destructive: latihan re-imports recreate by uuid, but
      // HQ-authored items are gone for good, and any in-flight
      // ease_responses pointing at the doc become orphan refs.
      // Observer back-write for endorsement denormalisation —
      // endorseCount + endorsedBy only.
      allow update: if isAdmin() || isCHCoordinator() ||
        ( isObserverStudent()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['endorseCount', 'endorsedBy']) );
      allow create: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // Audit trail for destructive ease_items operations. Append-only
    // — once a row lands, it cannot be edited or removed (even by
    // central_admin). Written client-side as part of the same
    // writeBatch as the deletion, so the audit record can't go
    // missing if the delete commits. Pins actorUid to auth.uid +
    // action to a known enum at create time so a malformed payload
    // can't enter the log.
    match /ease_items_audit/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.action in ['delete', 'bulk_delete', 'restore', 'create', 'update'];
      allow update, delete: if false;
    }

    match /ease_test_windows/{windowId} {
      allow get, list: if isAuthorized() || isActiveStudent();
      allow create, update, delete: if isAdmin();
    }

    match /ease_sessions/{sessionId} {
      allow get: if isAuthorized() ||
                    (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if isAuthorized();
      // Student creates their own session at start time (subjectId +
      // windowId pinned by client; rule pins studentUid).
      allow create: if isAdmin() ||
                       (isActiveStudent()
                        && request.resource.data.studentUid == request.auth.uid
                        && request.resource.data.schoolId == studentDoc().schoolId);
      // Student updates own session while in_progress (responses pushed
      // during run, then status flipped to 'submitted'). Final ritScore
      // / standardError / percentile written at submit. Once submitted,
      // the doc is immutable for students.
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.studentUid == request.auth.uid
                        && resource.data.status == 'in_progress'
                        && request.resource.data.studentUid == resource.data.studentUid
                        && request.resource.data.windowId == resource.data.windowId
                        && request.resource.data.subjectId == resource.data.subjectId);
      allow delete: if isAdmin();
    }

    match /ease_responses/{responseId} {
      allow get, list: if isAuthorized() ||
                          (isSignedIn() && resource.data.studentUid == request.auth.uid);
      // Student appends own response while session in_progress.
      // Immutable after creation.
      allow create: if isAdmin() ||
                       (isActiveStudent()
                        && request.resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /ease_growth/{growthId} {
      allow get: if isAuthorized() ||
                    (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if isAuthorized();
      allow create, update: if isAdmin() ||
                               (isActiveStudent()
                                && request.resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /parent_share_tokens/{token} {
      // get-by-id only — no list, even for admin.
      allow get: if true;     // token IS the auth — anyone with the URL
      allow list: if false;
      allow create: if isAdmin() ||
                       (isActiveStudent()
                        && request.resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin() ||
                               (isSignedIn() && resource.data.studentUid == request.auth.uid);
    }

    // ── Gamification (Students Hub, 2026-05-11) ────────────────
    // student_points + school_leaderboards are CLOUD-FUNCTION-ONLY writes.
    // Students cannot self-award; client write paths are blocked at the
    // rule level. Admin SDK (Cloud Functions) bypasses rules entirely.
    //
    // Read scope hardened 2026-08-20 (SH audit M8): a student may LIST only
    // rows from their own school — class / grade / school boards. Network
    // rankings are served exclusively by the school_leaderboards CF
    // aggregate (own read rule below); the client fallback no longer
    // queries network-wide. Staff (isAuthorized) keep full read.
    match /student_points/{uid} {
      allow get:    if isAuthorized() || isActiveStudent();
      allow list:   if isAuthorized()
                    || (isActiveStudent()
                        && resource.data.schoolId == studentDoc().data.schoolId);
      allow create, delete: if false;           // Cloud Function (admin SDK) only

      // Owner can flip lastStreakMilestone.seen from false to true,
      // exactly once per milestone payout. Cloud Function writes the
      // {day,bonus,seen:false,awardedAt} envelope; the dashboard
      // overlay marks it consumed so the celebration never repeats.
      // No other field may change via this path.
      allow update: if isSignedIn()
                    && uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastStreakMilestone'])
                    && request.resource.data.lastStreakMilestone.seen == true
                    && resource.data.lastStreakMilestone.seen == false
                    && request.resource.data.lastStreakMilestone.day   == resource.data.lastStreakMilestone.day
                    && request.resource.data.lastStreakMilestone.bonus == resource.data.lastStreakMilestone.bonus;
    }

    match /school_leaderboards/{boardId} {
      allow get:    if isAuthorized() || isActiveStudent();
      allow list:   if isAuthorized() || isActiveStudent();
      allow create, update, delete: if false;   // Cloud Function (admin SDK) only
    }

    // ── HQ Observer Question Flags (2026-05-13) ────────────────
    // Lightweight bug-report channel from inside Students Hub runners.
    // Only active students whose students/{uid}.is_hq_observer == true
    // can create rows (rule reads the student doc directly). HQ Subject
    // Specialists run as observer-student accounts during pilot QA so
    // they can flag bad items mid-runner without leaving the page.
    //
    // Specialists triage from CH /practice-bank-flags. The collection
    // is intentionally generic across `practice_questions`,
    // `chapter_test_items` and `ease_items` — the row carries
    // `itemId` + `collection` so the queue links to the right author/admin.
    //
    // Schema spec: docs/FIRESTORE_SCHEMA.md §23.
    match /practice_question_flags/{flagId} {
      function isObserverStudent() {
        return isSignedIn()
               && exists(/databases/$(database)/documents/students/$(request.auth.uid))
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.is_hq_observer == true
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
      }
      // CH reviewer = central_admin OR any signed-in central_user. Page-access
      // is the sole authorization gate since 2026-05-20 — admin manages who
      // sees /practice-bank-flags via page_access_config.visible_to[]. Any
      // central_user who reaches the page can triage.
      function isCHReviewer() {
        return isAdmin() || isCentralUser();
      }
      allow get, list: if isCHReviewer();
      allow create: if isObserverStudent()
                    && request.resource.data.flaggerUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.itemId is string
                    && request.resource.data.collection in ['practice_questions', 'chapter_test_items', 'ease_items'];
      // CH reviewers can flip status (open → triaged / fixed / wontfix / duplicate)
      // and append a triage note. Flagger fields stay immutable.
      allow update: if isCHReviewer()
                    && request.resource.data.flaggerUid     == resource.data.flaggerUid
                    && request.resource.data.itemId         == resource.data.itemId
                    && request.resource.data.collection     == resource.data.collection
                    && request.resource.data.createdAt      == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ── HQ Observer Question Endorsements (2026-05-14) ──────────
    // Companion to practice_question_flags. Same observer-student
    // gate, same CH reviewer browse, but the relationship is "I like
    // this question" rather than "this question has a problem".
    //
    // Doc id: `{itemId}_{specialistUid}` — deterministic, idempotent.
    // Re-saving on the same item is an update (specialists can tweak
    // their tag set or comment); Remove deletes the doc.
    // The item doc gets denormalised endorseCount + endorsedBy[] via
    // a separate back-write (rule per-collection above). When the two
    // diverge a CH cron / Cloud Function can re-derive from these
    // canonical endorsement rows.
    //
    // Tags allowed: {'curriculum-aligned', 'exam-style', 'conceptual'}.
    // Schema spec: docs/FIRESTORE_SCHEMA.md.
    match /practice_question_endorsements/{endorsementId} {
      function isObserverStudent() {
        return isSignedIn()
               && exists(/databases/$(database)/documents/students/$(request.auth.uid))
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.is_hq_observer == true
               && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
      }
      // CH reviewer = central_admin OR any signed-in central_user. See
      // practice_question_flags rule above for full reasoning. Page-access
      // is the sole authorization gate since 2026-05-20.
      function isCHReviewer() {
        return isAdmin() || isCentralUser();
      }
      function validTagsArray(tags) {
        return tags is list
               && tags.size() <= 3
               && tags.hasOnly(['curriculum-aligned', 'exam-style', 'conceptual']);
      }
      // Observer can read own row (for the prefill / edit flow); CH
      // reviewers can read everyone's.
      allow get:  if isCHReviewer()
                  || (isObserverStudent() && resource.data.specialistUid == request.auth.uid);
      allow list: if isCHReviewer();
      // Owner observer creates / updates own endorsement. Doc id must
      // match `{itemId}_{auth.uid}` so a specialist can't write under
      // someone else's id. Both create + update validate the tags
      // allowlist + the collection enum.
      allow create: if isObserverStudent()
                    && request.resource.data.specialistUid == request.auth.uid
                    && endorsementId == request.resource.data.itemId + '_' + request.auth.uid
                    && request.resource.data.itemId is string
                    && request.resource.data.collection in ['practice_questions', 'chapter_test_items', 'ease_items']
                    && validTagsArray(request.resource.data.tags);
      allow update: if isObserverStudent()
                    && resource.data.specialistUid == request.auth.uid
                    && request.resource.data.specialistUid == request.auth.uid
                    && request.resource.data.itemId        == resource.data.itemId
                    && request.resource.data.collection    == resource.data.collection
                    && validTagsArray(request.resource.data.tags);
      // Owner observer can revoke own endorsement. CH reviewers
      // (central_admin / director / coordinator) can delete any from
      // the /practice-bank-endorsements browse page — moderation +
      // bulk cleanup after a bad item is archived.
      allow delete: if isCHReviewer()
                    || (isObserverStudent() && resource.data.specialistUid == request.auth.uid);
    }

    // ── Practice + Daily Challenge (Students Hub, 2026-05-13) ──
    // practice_attempts: per-student self-paced runs over
    // practice_questions / practice_assessments. NEVER feeds
    // chapter_mastery or ease_growth (same boundary as
    // practice_questions — see CLAUDE.md Common Mistake #33).
    // Cloud Function will award `student_points` on submit; client
    // never writes student_points directly.
    //
    // Doc id pattern: auto-id. Owning student creates + updates own
    // doc while status=='in_progress'; once 'submitted' or 'scored'
    // it becomes immutable for the student (admin can fix).
    //
    // mode ∈ {'practice', 'daily_challenge', 'tournament'} so the
    // Cloud Function can apply per-mode point multipliers later.
    match /practice_attempts/{attemptId} {
      allow get: if isAuthorized() ||
                    (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow list: if isAuthorized();
      allow create: if isActiveStudent()
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.status == 'in_progress'
                    && request.resource.data.mode in ['practice', 'daily_challenge', 'tournament'];
      // Owner can keep appending answers while in_progress and flip
      // to submitted/scored exactly once. After that the doc is
      // immutable for the student (admin still has the standard
      // bypass via isAdmin / isAuthorized via the catch-all below).
      allow update: if isActiveStudent()
                    && resource.data.studentUid == request.auth.uid
                    && resource.data.status == 'in_progress';
      allow delete: if isAdmin();
    }

    // daily_challenges: one curated set per day per subject.
    // Doc id pattern: '{YYYY-MM-DD}_{subjectId}' so the SH client
    // can compute today's id without a query.
    // Authored by HQ (admin / CH coordinator / director) or by a
    // scheduled Cloud Function (admin SDK bypass) that rotates a
    // fresh set every midnight. References practice_assessments
    // (not raw practice_questions) so the same composer surfaces
    // both bundles for tournaments AND daily-challenges.
    match /daily_challenges/{challengeId} {
      allow get, list: if isAuthorized() || isActiveStudent();
      allow create, update: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
    }

    // -- announcements ---------------------------------------
    match /announcements/{annId} {
      allow read:   if isAuthorized();
      // central_admin + CH coordinator can create; delete stays admin-only.
      allow create: if isAdmin() || isCHCoordinator();
      allow delete: if isAdmin();
      // Admin + coordinator can update freely; any authorised user can bump
      // commentCount only (so non-admin commenters can keep the count in sync
      // after addDoc).
      allow update: if isAdmin() || isCHCoordinator()
                       || (isAuthorized()
                           && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['commentCount']));

      // comments sub-collection (used by Academic Hub & Teachers Hub)
      match /comments/{commentId} {
        allow read:   if isAuthorized();
        allow create: if isAuthorized()
                         && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin()
                         || (isAuthorized() && resource.data.authorUid == request.auth.uid);
        allow update: if false;
      }
    }

    // -- surveys (cross-platform) ----------------------------
    // Since 2026-05-20: create/update opened to CH central_user
    // (page-access gates /survey-console). Delete stays admin-only.
    match /surveys/{surveyId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- survey_responses ------------------------------------
    match /survey_responses/{responseId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidResponsePayload(request.resource.data);

      allow update: if isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       isValidResponsePayload(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.surveyId == resource.data.surveyId &&
                       request.resource.data.platform == resource.data.platform;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // -- central_documents -----------------------------------
    // Since 2026-05-20: create/update opened to CH central_user
    // (page-access gates /inventory). Delete stays admin-only.
    match /central_documents/{docId} {
      allow read:   if isAuthorized();
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- central_certificates --------------------------------
    match /central_certificates/{docId} {
      allow read:   if isAuthorized();
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- calendar_events (Academic Calendar admin-managed events) --
    match /calendar_events/{docId} {
      allow read:                    if isAuthorized();
      allow create, update:          if isAdmin() || isCentralUser();
      allow delete:                  if isAdmin();
    }

    // -- calendar_settings (Single-doc academic year config: yearStart, totalWeeks, terms) --
    // Settings doc affects every page's date logic — kept admin-only to
    // avoid accidental year-rollover from a coordinator's misclick.
    match /calendar_settings/{docId} {
      allow read:   if isAuthorized();
      allow write:  if isAdmin();
    }

    // -- teaching_schedule (Pre-computed teaching weeks per subject, written by admin Sync) --
    match /teaching_schedule/{docId} {
      allow read:   if isAuthorized();
      allow write:  if isAdmin() || isCentralUser();
    }

    // -- nav_config (Navbar item order + labels, editable by central_admin) --
    // Navbar config affects every CH user — kept admin-only.
    match /nav_config/{docId} {
      allow read:   if isAuthorized();
      allow write:  if isAdmin();
    }

    // -- weekly_essentials (Standing recurring checklist items, per platform) --
    match /weekly_essentials/{platform} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCentralUser();
    }

    // -- weekly_templates (Weekly checklist templates) -------
    match /weekly_templates/{docId} {
      allow read:                    if isAuthorized();
      allow create, update:          if isAdmin() || isCentralUser();
      allow delete:                  if isAdmin();
    }

    // -- weekly_progress (Per-user checklist progress) -------
    // Read access (per Step 1.2 hardening — was previously open to any
    // authorised user, leaking checklist progress across the network):
    //   - the owner (their own doc)
    //   - central_admin and CH coordinators (checklist-admin, reports,
    //     network-health, dashboard widgets)
    //   - same-school AH leadership: school_principal or
    //     academic_coordinator only
    // Collection queries are restricted to admins/coordinators because
    // we cannot enforce schoolId filtering at the `list` level without
    // either denormalising schoolId onto the doc or forcing a
    // per-uid get loop client-side.
    match /weekly_progress/{docId} {
      allow get:    if isSignedIn() && (
                      resource.data.userId == request.auth.uid
                      || isAdmin()
                      || isCHCoordinator()
                      || (isAHUserAtSameSchool(resource.data.userId)
                          && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator']))
                    );
      allow list:   if isAdmin() || isCHCoordinator();
      allow create, update: if request.auth != null
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // -- school_appraisals_v2 (interactive 5-domain appraisal tool) --
    //
    // Models the two-sided flow in ES 17.7 / 17.8 (Section 17, Quality
    // Assurance and Internal Review):
    //   17.7  the school's own self-evaluation — its ratings and evidence
    //   17.8  Eduversal's external appraisal, "conducted annually by
    //         Eduversal's appraisal team", whose written report carries the
    //         commendations and recommendations back to the school
    //
    // Read:   any Central Hub or Academic Hub user
    // Create: central_admin, or an academic user for their own school
    // Update: four distinct writers, deliberately NOT one "review" permission:
    //   (a) central_admin — any field, including closing the record as
    //       'reviewed'. Publishing the appraisal report is a single
    //       accountable act, so sign-off stays with admin alone.
    //   (b) academic_user/admin at the same school — their own self-appraisal
    //       (ratings / evidence / strengths / improvements).
    //   (c) any central_user (coordinator) — recommendations ONLY, and only
    //       while the record is still open. ES 17.8 puts the appraisal in the
    //       hands of a team, so the coordinator who ran the visit must be able
    //       to write the finding; without this they could see the box but
    //       every save was refused. The affectedKeys() clamp is the load-
    //       bearing part: it stops Eduversal silently rewriting the school's
    //       own ratings, keeping each side's statement its own (same
    //       principle as scorecard immutability and Charter NN1).
    //   (d) any central_user — externalReview ONLY, while the record is open.
    //       ES 17.8's written report must carry "Ratings or indicators of
    //       performance level", so Eduversal needs its OWN rating per aspect,
    //       not just prose. This is the two-rater model: the school's ratings
    //       map stays unreachable from here (it is absent from the hasOnly
    //       list) and Eduversal's parallel rating lands in a sibling field, so
    //       neither side can overwrite the other and the delta stays visible.
    //       Each phase also records the team that ATTENDED — team[] and
    //       domainPic{} as role tags, pre-filled from the supervision plan on
    //       partner_schools but correctable, because cover happens. An appeal
    //       under model §8.1 must be reviewed with whoever saw that domain,
    //       which the plan alone cannot tell you.
    //       teamConfirmed is intended as an admin act and the UI gates it
    //       that way, but this rule does NOT enforce it: phases{} is checked
    //       at the top level only, so any central_user who bypassed the UI
    //       could set it. Acceptable for now — every CH user is HR-onboarded
    //       staff and teamConfirmedBy records who claimed it — but if that
    //       flag ever gates something consequential, enforce it here first.
    //       externalReview.phases{phase_1, phase_2, phase_3} splits Eduversal's
    //       findings by visit — the Updated Appraisal Model (AY 2026-2027)
    //       sends a team twice, 56-63 days apart, and the Annual Report
    //       summarises BOTH. Phase 1 and 3 carry ratings + justifications;
    //       Phase 2 is an online check-in and carries only an outcome. The
    //       school's own ratings stay a single map — it self-appraises once a
    //       year and Phase 3 validates that same submission.
    //       Value vocabularies (outcome / phase codes) come verbatim from
    //       Academic Hub/resources/school-appraisal-framework.json
    //       meta.external_evaluation.
    //
    //       externalReview.report holds the written report (ES 17.8, "within
    //       10 business days"): auto-drafted from the ratings, the deltas and
    //       the coordinator's own text, then edited by hand before publish.
    //       Its own status field — not the record's — decides whether the
    //       school sees it, so a half-written report never leaks: read here is
    //       open to any academic user (they must be able to read their own
    //       record), and it is the UI that shows the report only once
    //       report.status == 'published'. Treat that as a presentation rule,
    //       not a confidentiality boundary: never put anything in the draft
    //       that would harm the school if read early.
    //   (e) the school (AH user at this school) — actionPlan.items ONLY.
    //       ES 17.8 closes the cycle with the school's response: within 4
    //       weeks of the report it "develops an action plan addressing
    //       recommendations" and "assigns responsibilities, timelines, and
    //       resources". The plan is the SCHOOL's, so the school writes it —
    //       Eduversal cannot edit an item, only review progress against it.
    //   (f) any central_user — actionPlan.reviews ONLY. Eduversal's quarterly
    //       check-ins on that plan (ES 17.8 "Monitoring and Progress
    //       Reporting"; model §4C puts action-plan status on the Phase 2
    //       agenda). Appending a review can never alter what the school
    //       committed to, which is what keeps the record honest about who
    //       said what.
    //   (g) the school (AH user at this school) — appeals.cases ONLY, and
    //       only the school's own half of a case. The Updated Appraisal Model
    //       §8.1 lets a school challenge a domain rating it believes the
    //       evidence does not support: 10 working days to submit, and the
    //       decision comes back within 15.
    //       The school can NEVER write a decision — that is the whole point
    //       of an appeal being reviewed by someone else. Enforced by keeping
    //       decisions in a sibling map that this branch cannot reach.
    //   (h) central_admin decides appeals — appeals.decisions ONLY.
    //       The model names the CAO; central_admin is that authority here
    //       (since 2026-05-20 it is the sole rule-level bypass, and "the
    //       decision is final" wants the narrowest possible door). A
    //       coordinator can read an appeal but cannot close it.
    //       Note admin already passes branch (a) and can write anything; (h)
    //       exists so the intent is legible in the rules rather than implied.
    // Delete: central_admin only
    //
    // Note: (c) through (h) are narrow, field-scoped exceptions to the
    // 2026-05-20 model in which central_admin is the sole rule-level writer.
    // All are justified by ES 17.8 or the Updated Appraisal Model; do not
    // widen any of them to further fields without revisiting that decision.
    //
    // The actionPlan split is deliberate and load-bearing: items[] and
    // reviews[] are separate arrays with separate writers, so neither side
    // can rewrite the other's words. Same principle as the two-rater ratings
    // split above.
    //
    // Not enforced here: "a justification is required when Eduversal's rating
    // differs from the school's". Expressing that needs a per-aspect crosswalk
    // over all 31 aspect keys, which cannot be written cheaply and would break
    // the moment the framework adds an aspect. It is enforced in the UI
    // (school-appraisals.html saveAppraisal) and the audit trail —
    // externalReview.evaluatedBy plus the visible delta — is what makes a
    // missing justification obvious to a reviewer.
    match /school_appraisals_v2/{docId} {
      allow read:   if isCentralUser() || isAcademicUser();
      allow create: if isAdmin()
                    || (isAcademicUser()
                        && request.resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow update: if isAdmin()
                    || (isAcademicUser()
                        && resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId)
                    || (isCentralUser()
                        && resource.data.status != 'reviewed'
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['recommendations', 'updatedAt', 'updatedBy']))
                    || (isCentralUser()
                        && resource.data.status != 'reviewed'
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['externalReview', 'updatedAt', 'updatedBy'])
                        && request.resource.data.externalReview is map
                        && request.resource.data.externalReview.keys().hasOnly([
                             'phases', 'report', 'frameworkVersion'
                           ]))
                    // (e) the school writes its own action plan — items only.
                    // 'reviews' is in the key list so a school save round-trips
                    // Eduversal's reviews rather than dropping them, but the
                    // equality check below stops the school editing them.
                    || (isAcademicUser()
                        && resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['actionPlan', 'updatedAt', 'updatedBy'])
                        && request.resource.data.actionPlan is map
                        && request.resource.data.actionPlan.keys().hasOnly([
                             'items', 'submittedAt', 'submittedBy', 'status', 'reviews'
                           ])
                        && request.resource.data.actionPlan.get('reviews', [])
                             == resource.data.get('actionPlan', {}).get('reviews', []))
                    // (f) Eduversal appends progress reviews — reviews only.
                    || (isCentralUser()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['actionPlan', 'updatedAt', 'updatedBy'])
                        && request.resource.data.actionPlan is map
                        && request.resource.data.actionPlan.keys().hasOnly([
                             'items', 'submittedAt', 'submittedBy', 'status', 'reviews'
                           ])
                        // The school's own commitments are untouchable from
                        // here: items must arrive back exactly as stored.
                        && request.resource.data.actionPlan.get('items', [])
                             == resource.data.get('actionPlan', {}).get('items', []))
                    // (g) the school lodges an appeal — cases only, never a
                    // decision. Decisions live in a sibling map this branch
                    // cannot write, which is what makes the appeal an appeal.
                    || (isAcademicUser()
                        && resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['appeals', 'updatedAt', 'updatedBy'])
                        && request.resource.data.appeals is map
                        && request.resource.data.appeals.keys().hasOnly(['cases', 'decisions'])
                        && request.resource.data.appeals.get('decisions', {})
                             == resource.data.get('appeals', {}).get('decisions', {}))
                    // (h) central_admin rules on it — decisions only, cases
                    // carried back untouched so the school's stated grounds
                    // cannot be edited to fit the decision.
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['appeals', 'updatedAt', 'updatedBy'])
                        && request.resource.data.appeals is map
                        && request.resource.data.appeals.keys().hasOnly(['cases', 'decisions'])
                        && request.resource.data.appeals.get('cases', {})
                             == resource.data.get('appeals', {}).get('cases', {}));
      allow delete: if isAdmin();
    }

    // -- appraisal_cycles (Central Hub cycle management) ------
    // Read: any authenticated user (apps need to know if a cycle is open).
    // Since 2026-05-20: create/update opened to CH central_user
    // (page-access gates /appraisals). Delete stays admin-only.
    match /appraisal_cycles/{docId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- teacher_appraisals (Formal Appraisal v2.0) ----------
    // Create:  academic_admin or academic_user with school_principal/academic_coordinator/cambridge_coordinator
    //          sub-role; ALSO any central_user — Eduversal Subject Specialists
    //          observe teachers in their subject during on-site visits
    //          (ES 17.8.2 "Day 1: Subject Teacher Appraisals and Walkthroughs"),
    //          entered from CH /teacher-appraisal-entry. Central creators must
    //          stamp themselves as the appraiser so the update branch below
    //          scopes them to their own records.
    // Read:    the teacher who owns it (teacherUid == uid), any AH admin, any TH admin, central_admin
    // Update:  appraiser (AH admin/sub-role) can update any field while status != finalised;
    //          a central_user may update their OWN record until it is finalised;
    //          teacher can update teacherResponse + status (shared → acknowledged) only
    // Delete:  central_admin only
    match /teacher_appraisals/{docId} {
      allow read: if isAdmin()
                  || isCentralUser()
                  || isAHAdmin()
                  || isTeachersAdmin()
                  || (isTeachersUser() && resource.data.teacherUid == request.auth.uid)
                  || (isAcademicUser() && resource.data.appraiserUid == request.auth.uid);
      allow create: if isAHAdmin()
                    || (isAcademicUser()
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator', 'cambridge_coordinator']))
                    || (isCentralUser()
                        && request.resource.data.appraiserUid == request.auth.uid);
      allow update: if isAdmin()
                    || isAHAdmin()
                    || (isAcademicUser()
                        && resource.data.appraiserUid == request.auth.uid
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator', 'cambridge_coordinator']))
                    || (isCentralUser()
                        && resource.data.appraiserUid == request.auth.uid
                        && resource.data.status != 'finalised')
                    || (isTeachersUser()
                        && resource.data.teacherUid == request.auth.uid
                        && resource.data.status == 'shared'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherResponse', 'status', 'updatedAt']))
                    || (isTeachersUser()
                        && resource.data.teacherUid == request.auth.uid
                        && resource.data.status == 'finalised'
                        && !resource.data.disputed
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputed', 'disputeReason', 'disputedAt', 'disputeStatus']));
      allow delete: if isAdmin();
    }

    // -- specialist_observations (Eduversal Specialist Lesson Observation) ----
    // F2-only lesson observations recorded by Eduversal Subject Specialists on
    // an on-site school visit, from CH /teacher-appraisal-entry.
    //
    // DELIBERATELY SEPARATE from teacher_appraisals. A specialist observation is
    // Eduversal's own quality lens on teaching across the network; the school's
    // formal appraisal is owned by the school's leadership and is the record
    // that carries a composite + predicate. Keeping them in one collection made
    // a partial F2 row look like a whole four-block appraisal to
    // /teacher-appraisals and /reports. Same separation principle as
    // induction_observations vs appraisal (Charter NN1).
    //
    // Create:  central_user stamping themselves as the observer
    // Read:    the teacher, the observer, AH admin, TH admin, central_admin.
    //          AH leadership can see Eduversal's observation of their own staff.
    // Update:  the observer who created it, while not finalised; admins
    // Delete:  central_admin only
    match /specialist_observations/{docId} {
      allow read: if isAdmin()
                  || isCentralUser()
                  || isAHAdmin()
                  || isTeachersAdmin()
                  || (isTeachersUser() && resource.data.teacherUid == request.auth.uid)
                  || (isAcademicUser() && resource.data.schoolId == userProfile().schoolId);
      allow create: if isAdmin()
                    || (isCentralUser()
                        && request.resource.data.observerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isCentralUser()
                        && resource.data.observerUid == request.auth.uid
                        && resource.data.status != 'finalised');
      allow delete: if isAdmin();
    }

    // -- teacher_self_appraisals (Teacher Self-Appraisal) -----
    // Doc ID format: {userId}_{academicYear}  (e.g. abc123_2025-26)
    //
    // Read access:
    //   - the owner (resource.data.userId == auth.uid)
    //   - central_admin, AH admin, TH admin (full access for tooling)
    //   - same-school AH evaluator with school_principal /
    //     academic_coordinator / cambridge_coordinator sub-role
    //
    // No code path issues a collection query, so list is admin-only and
    // sub-role evaluators must look up by deterministic doc ID.
    //
    // Create/update: the teacher themselves (userId match). Status !=
    // submitted for updates (locks the doc once submitted). Delete:
    // central_admin.
    match /teacher_self_appraisals/{docId} {
      allow get:    if (isSignedIn() && resource != null && resource.data.userId == request.auth.uid)
                    || isAdmin()
                    || isAHAdmin()
                    || isTeachersAdmin()
                    || (isAcademicUser()
                        && isAHUserAtSameSchool(resource.data.userId)
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator', 'cambridge_coordinator']));
      allow list:   if isAdmin() || isAHAdmin() || isTeachersAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (isTeachersUser() || isTeachersAdmin());
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && resource.data.status != 'submitted'
                    && (isTeachersUser() || isTeachersAdmin());
      allow delete: if isAdmin();
    }

    // -- teacher_walkthroughs (Classroom Walkthrough v2.0) ---
    // Create:  academic_admin, or academic_user with school_principal/academic_coordinator/cambridge_coordinator sub-role
    // Read:    the teacher (teacherUid), appraiser (observerUid), AH admin, TH admin, central_admin
    // Update:  observer who created it, or AH admin (within same academic year — no cross-year edits)
    // Delete:  central_admin or AH admin only
    match /teacher_walkthroughs/{docId} {
      allow read: if isAdmin()
                  || isCentralUser()
                  || isAHAdmin()
                  || isTeachersAdmin()
                  || (isTeachersUser() && resource.data.teacherUid == request.auth.uid)
                  || (isAcademicUser() && resource.data.observerUid == request.auth.uid);
      // central_user branch: Eduversal Subject Specialists run walkthroughs
      // alongside the formal observation on an on-site visit (ES 17.8.2,
      // "Day 1: Subject Teacher Appraisals and Walkthroughs"), entered from
      // CH /walkthrough-entry. Creators must stamp themselves as the observer
      // so the update branch scopes them to their own records.
      allow create: if isAHAdmin()
                    || (isAcademicUser()
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator', 'cambridge_coordinator']))
                    || (isCentralUser()
                        && request.resource.data.observerUid == request.auth.uid);
      allow update: if isAdmin()
                    || isAHAdmin()
                    || (isAcademicUser()
                        && resource.data.observerUid == request.auth.uid
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator', 'cambridge_coordinator']))
                    || (isCentralUser()
                        && resource.data.observerUid == request.auth.uid);
      allow delete: if isAdmin() || isAHAdmin();
    }

    // -- ease_system -----------------------------------------
    match /ease_system/{docId} {
      allow read:   if isAuthorized();
      allow write:  if isAdmin() || isCentralUser();
    }

    // -- documents (Academic Hub) ----------------------------
    match /documents/{docId} {
      allow read:   if isAuthorized();
      allow create, update, delete: if isAHAdmin();
    }

    // -- doc_likes (Academic Hub) ----------------------------
    match /doc_likes/{likeId} {
      allow read:  if isAuthorized();
      allow write: if isAuthorized() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthorized();
    }

    // -- doc_ratings (Academic Hub) --------------------------
    match /doc_ratings/{ratingId} {
      allow read:  if isAuthorized();
      allow write: if isAuthorized() && request.resource.data.userId == request.auth.uid;
    }

    // -- library (Academic Hub) ------------------------------
    match /library/{resourceId} {
      allow read:   if isAuthorized();
      allow create, delete: if isAHAdmin();
      allow update: if isAHAdmin();
    }

    // -- prompts (Academic Hub - AI Prompts) -----------------
    match /prompts/{promptId} {
      allow read:   if isAuthorized();
      allow create, delete: if isAHAdmin();
      // Any user can increment the `uses` counter; only admin can edit other fields
      allow update: if isAHAdmin()
                    || (isAuthorized()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']));
    }

    // -- feedbacks (consolidated 2026-05-03 — was feedback + feedbacks) --
    //    All hubs (CH/AH/TH) now write here with a `__src` discriminator.
    // Since 2026-05-20: read + update opened to CH central_user
    // (page-access gates /feedback-management). Delete stays admin-only.
    match /feedbacks/{fbId} {
      // 2026-08-01 hardening: create was a zero-validation open door for
      // every school-domain account — now the shared payload core
      // (subject / message / __src) is type- and size-checked, and an
      // author uid, when present, must be the caller's own.
      allow create: if isAuthorized()
                    && request.resource.data.__src in ['centralhub', 'academichub', 'teachershub']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 300
                    && (!('userId' in request.resource.data)
                        || request.resource.data.userId == null
                        || request.resource.data.userId == request.auth.uid);
      allow read, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- timeline_activities (Academic Calendar) -------------
    match /timeline_activities/{actId} {
      allow read:   if isAuthorized();
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    // -- timeline_completions (Academic Calendar) ------------
    match /timeline_completions/{compId} {
      allow read:   if isAuthorized();
      allow write:  if isAuthorized() && request.resource.data.userId == request.auth.uid;
    }

    // Teachers Hub admin: teachers_admin role
    function isTeachersAdmin() {
      return isAuthorized() && userProfileExists() &&
             userProfile().role_teachershub == 'teachers_admin';
    }

    // -- Cambridge syllabus reference data (all levels: IGCSE, AS/A-Level, Checkpoint) -----------------------
    // Read open to any authenticated user (Teachers Hub, Academic Hub, Central Hub all need this).
    // Since 2026-05-20: write opened to CH central_user (page-access gates
    // /igcse-syllabus, /as-alevel-syllabus, /secondary-checkpoint-syllabus,
    // /primary-checkpoint-syllabus).
    match /cambridge_syllabus/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isCentralUser();
    }

    // -- Cambridge scheme of work — teaching activities, resources, SDG links per ref code.
    match /cambridge_scheme_of_work/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isCentralUser();
    }

    // -- Curated Stage 7→8→9 progression mapping (one doc per subject code).
    match /cambridge_syllabus_progression/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isCentralUser();
    }

    // -- Indonesian Kurikulum Merdeka curriculum chapters --
    match /km_curriculum/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isCentralUser();
    }

    // -- Master conceptual taxonomy linking Cambridge G7-12 LOs with KM chapters.
    match /curriculum_master_topics/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isCentralUser();
    }

    // -- IGCSE / A-Level / Checkpoint pacing structures ------
    // Read: any authorised user (pacing structure isn't sensitive).
    // Write: central_admin (full), CH coordinator (cross-subject),
    //        or a CH Subject Specialist whose ch_subjects[] matches
    //        this collection's subject. Combined-science pacing
    //        (checkpoint_science / primary_science) accepts any of
    //        biology / chemistry / physics specialists.
    //        TH admin retains write access on Checkpoint / AS-A /
    //        Primary collections (existing pattern).

    // ── IGCSE single-subject pacing ─────────────────────────────────
    match /math_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['math']);
    }
    match /biology_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['biology']);
    }
    match /chemistry_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['chemistry']);
    }
    match /physics_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['physics']);
    }

    // ── AS / A-Level single-subject pacing ──────────────────────────
    match /asalevel_math_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['math']);
    }
    match /asalevel_biology_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['biology']);
    }
    match /asalevel_chemistry_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['chemistry']);
    }
    match /asalevel_physics_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['physics']);
    }

    // ── Checkpoint pacing ───────────────────────────────────────────
    match /checkpoint_math_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['math']);
    }
    match /checkpoint_english_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['english']);
    }
    // Checkpoint Science is combined biology + chemistry + physics
    match /checkpoint_science_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['biology', 'chemistry', 'physics']);
    }

    // ── Primary pacing ──────────────────────────────────────────────
    match /primary_math_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['math']);
    }
    match /primary_english_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['english']);
    }
    // Primary Science is combined biology + chemistry + physics
    match /primary_science_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['biology', 'chemistry', 'physics']);
    }

    // ── Eduversal-authored non-Cambridge pacing (Bahasa Indonesia + Edu-STEAM) ──
    // No Cambridge syllabus code; EDV-prefix placeholder. Single-subject gate
    // per stage, mirroring the math/english single-subject pattern above.
    // Bahasa Indonesia — all 4 stages
    match /primary_bahasa_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['bahasa']);
    }
    match /checkpoint_bahasa_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['bahasa']);
    }
    match /bahasa_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['bahasa']);
    }
    match /asalevel_bahasa_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['bahasa']);
    }
    // Edu-STEAM — all 4 stages
    match /primary_edu_steam_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['edu_steam']);
    }
    match /checkpoint_edu_steam_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['edu_steam']);
    }
    match /edu_steam_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['edu_steam']);
    }
    match /asalevel_edu_steam_pacing/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTeachersAdmin() || isAdmin() || isCHCoordinator() || isCHSubjectSpecialist(['edu_steam']);
    }

    // -- userProgress (per-user pacing progress) -------------
    // Academic Hub users can read progress of teachers at their same school
    // (for the Syllabus Coverage dashboard). Uses schoolId field on user profiles.
    function isAHUserAtSameSchool(targetUid) {
      return isAcademicUser() &&
        get(/databases/$(database)/documents/users/$(targetUid)).data.schoolId ==
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId;
    }

    // schoolId-based variant — used by school-scoped collections
    // (school_leadership_*, school_artifacts, school_activity_*) where
    // the doc itself carries schoolId. Avoids the second get() that
    // isAHUserAtSameSchool(uid) needs.
    function isAHUserAtSchool(schoolId) {
      return isAcademicUser() && userProfile().schoolId == schoolId;
    }
    // School leadership team member at given school. Audience: FR + SP +
    // AC + CC. academic_admin bypasses via isAHAdmin() composition at
    // call site.
    function isAHSchoolLeader(schoolId) {
      return isAHUserAtSchool(schoolId)
             && userProfile().ah_sub_roles is list
             && userProfile().ah_sub_roles.hasAny([
                  'foundation_representative',
                  'school_principal',
                  'academic_coordinator',
                  'cambridge_coordinator'
                ]);
    }

    // School-agnostic variant for `list` rules, which cannot inspect the
    // matched docs' fields (a query has no single `resource`). The caller must
    // constrain the query itself — AH teacher search adds
    // where('schoolId','==',<own school>) — so this grants "may run a
    // leadership-scoped query", not "may read every doc".
    function isAHSchoolLeaderAnySchool() {
      return isAcademicUser()
             && userProfile().ah_sub_roles is list
             && userProfile().ah_sub_roles.hasAny([
                  'foundation_representative',
                  'school_principal',
                  'academic_coordinator',
                  'cambridge_coordinator'
                ]);
    }

    match /userProgress/{uid} {
      allow get:   if (isSignedIn() && request.auth.uid == uid)
                   || isAdmin()
                   || isCHCoordinator()
                   || isAHUserAtSameSchool(uid);
      allow list:  if isAdmin() || isCHCoordinator() || isAcademicUser();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // -- activity_projects (Activities board) ----------------
    match /activity_projects/{docId} {
      allow read:                    if isAuthorized();
      allow create, update, delete:  if isAdmin();
    }

    // -- activity_tasks (Activities board tasks) -------------
    // All authorized users can update (for status changes).
    // Only admins can create or delete tasks.
    match /activity_tasks/{docId} {
      allow read:           if isAuthorized();
      allow create, delete: if isAdmin();
      allow update:         if isAuthorized();
    }

    // -- activity_groups (Assignee groups for Activities) ----
    match /activity_groups/{docId} {
      allow read:                    if isAuthorized();
      allow create, update, delete:  if isAdmin();
    }

    // -- section_overrides (Academic Standards inline edits) -
    match /section_overrides/{sectionId} {
      allow read: if isAuthorized();
      allow write: if isAHAdmin();

      match /subsections/{subId} {
        allow read: if isAuthorized();
        allow write: if isAHAdmin();
      }
    }

    // -- partner_schools (canonical school directory) --------
    // Read: any authorised user — Teachers Hub (auth-guard school picker
    //       + pacing pages reading classes subcollection), Academic Hub
    //       (KPI school selector), Central Hub (console).
    // Write: isAHAdmin() covers central_admin + academic_admin.
    //
    // The legacy `schools` collection was migrated into this one on
    // 2026-05-02 (see scripts/page-access/migrate-schools-to-partner.js
    // and the monorepo CLAUDE.md). Each doc now also carries a `domain`
    // field used by AH/TH auth-guard to auto-default the school selector
    // from the user's email domain.
    match /partner_schools/{schoolId} {
      allow read:  if isAuthorized();
      allow write: if isAHAdmin();

      // classes subcollection — teachers add new classes for their school;
      // only admins can delete.
      // 2026-08-01 hardening: create/update was bare isSignedIn() — ANY
      // authenticated account (students, careers magic-link users, staff
      // of other schools) could overwrite any school's class records.
      // Now: admin, or staff whose users/{uid}.schoolId matches this
      // school (TH onboarding writes schoolId to the profile BEFORE the
      // class-pool sync, so first-login class creation still works).
      match /classes/{classId} {
        allow read:           if isAuthorized();
        allow create, update: if isAdmin()
                              || (isAuthorized() && userProfileExists()
                                  && userProfile().schoolId == schoolId);
        allow delete:         if isAdmin();
      }
    }

    // -- kpi_config (School Performance KPI - criteria definitions) --
    // Read: AH users (school KPI is visible to academic side).
    // Write: AH admin OR any CH central_user — /page-access UI on CH side
    // gates who reaches /kpi-admin; rule trusts the gate (since 2026-05-20).
    match /kpi_config/{kpiId} {
      allow read:  if isAcademicUser();
      allow write: if isAHAdmin() || isCentralUser();
    }

    // -- kpi_settings (School Performance KPI - semester settings) ---
    match /kpi_settings/{semId} {
      allow read:  if isAcademicUser();
      allow write: if isAHAdmin() || isCentralUser();
    }

    // -- kpi_config_legacy_pre_v1 (one-shot archive snapshot, 2026-05-27) --
    // Read: central_admin only (audit trail for pre-v1 KPI definitions).
    // Write: deny — populated exclusively by scripts/kpi/seed-school-kpi-v1.js
    // running with service-account credentials, which bypasses rules.
    match /kpi_config_legacy_pre_v1/{originalId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // -- teacher_kpi_config_legacy_pre_v1 (one-shot archive snapshot, 2026-05-27) --
    // Twin of kpi_config_legacy_pre_v1 — captures the pre-v1 teacher KPI state
    // before scripts/kpi/seed-teacher-kpi-v1.js remediated invalid CTS 6.x refs
    // and added the full 9-chip-family tagging.
    match /teacher_kpi_config_legacy_pre_v1/{originalId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // -- teacher_kpi_config (Teacher KPI criteria definitions) -------
    // Read: any authorized user (teachers may need to view their KPI criteria)
    // Write: admin OR any CH central_user (page-access gates /kpi-admin).
    match /teacher_kpi_config/{kpiId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCentralUser();
    }

    // -- teacher_kpi_settings (Teacher KPI evaluation periods) -------
    match /teacher_kpi_settings/{periodId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCentralUser();
    }

    // -- teacher_kpi_evaluations (Admin evaluations of teacher submissions) --
    // Doc ID = submissionId (same as teacher_kpi_submissions for 1-1 relationship)
    // Read:  central_admin, academic_admin/user (AH evaluators), teachers_admin
    // Write: academic_admin OR academic_user with school_principal/academic_coordinator sub-role
    // Teacher: read only their own evaluation
    match /teacher_kpi_evaluations/{submissionId} {
      // Teacher owner read first — relies only on the resource itself, not on
      // userProfile() which can throw on missing/partial profiles and silently
      // collapse the OR chain to false. Matches the same pattern used on
      // teacher_kpi_submissions.
      allow read: if isSignedIn() && resource != null && resource.data.teacherUid == request.auth.uid
                  || isAdmin()
                  || isAHAdmin()
                  || isTeachersAdmin()
                  || (isAcademicUser() && userProfile().uid == resource.data.evaluatorInfo.evaluatorUid);
      allow create, update: if isAHAdmin()
                            || (isAcademicUser()
                                && (userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator'])));
      allow delete: if isAdmin();
    }

    // -- teacher_kpi_submissions (Teacher self-assessment submissions) --
    // Doc ID format: {userId}_{periodId}
    // Submissions carry a `schoolId` field (set by Teachers Hub on save) so
    // AH sub-role evaluators can be school-scoped at both rule and query
    // level.
    //
    // Read access:
    //   - the owner (resource.data.userId == auth.uid)
    //   - central_admin and TH admin (full access for tooling)
    //   - AH admin (academic_admin — full network access)
    //   - same-school AH evaluators with school_principal or
    //     academic_coordinator sub-role
    // Create/update: teacher who owns the submission. The schoolId on the
    // payload must match the writer's profile schoolId so a teacher cannot
    // forge a submission claiming to belong to another school.
    // Delete: central_admin only.
    match /teacher_kpi_submissions/{submissionId} {
      // Owner read: any signed-in user can read their own submission, even
      // before their TH role/profile fields are fully populated. The doc-owner
      // check (resource.data.userId == auth.uid) is the strongest guarantee;
      // we don't gate it on userProfile() lookups that could throw on missing
      // sibling fields and silently collapse the whole OR chain to false.
      allow read: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid
                  || isAdmin()
                  || isCentralUser()  // CH reviewers reach via /kpi-admin (page-access gates)
                  || isTeachersAdmin()
                  || isAHAdmin()
                  || (isAcademicUser()
                      && resource.data.schoolId != null
                      && resource.data.schoolId == userProfile().schoolId
                      && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator']));
      allow create: if isTeachersUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.schoolId == userProfile().schoolId;
      allow update: if (
                      // Owner editing own submission. schoolId stays pinned
                      // to their profile to prevent forgery.
                      isTeachersUser()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.schoolId == userProfile().schoolId
                    )
                    || (
                      // AH evaluator (admin or sub-role) marking submission
                      // as evaluated/finalized. They may only flip workflow
                      // fields — not the teacher's actual answers.
                      (
                        isAHAdmin()
                        || (isAcademicUser()
                            && resource.data.schoolId == userProfile().schoolId
                            && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator']))
                      )
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'evaluatedAt', 'updatedAt'])
                    )
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // -- kpi_meeting_proposals (Evaluator proposes meeting date to teacher) --
    // Doc ID: auto
    // Fields: submissionId, teacherUid, proposedDate, time, location, note, status (pending/confirmed/declined)
    // Read:  evaluators (AH admin/user), the teacher whose submission it is, teachers_admin
    // Write: evaluators create/update; teacher updates status only
    match /kpi_meeting_proposals/{proposalId} {
      allow read: if isAdmin()
                  || isAHAdmin()
                  || isTeachersAdmin()
                  || (isAcademicUser() && resource.data.evaluatorUid == request.auth.uid)
                  || (isTeachersUser() && resource.data.teacherUid == request.auth.uid);
      allow create: if isAHAdmin()
                    || (isAcademicUser()
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator']));
      allow update: if isAHAdmin()
                    || (isAcademicUser()
                        && userProfile().ah_sub_roles.hasAny(['school_principal', 'academic_coordinator']))
                    || (isTeachersUser()
                        && resource.data.teacherUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'respondedBy']));
      allow delete: if isAdmin();
    }

    // -- school_performance_kpi (KPI data submissions) -------
    // Structure: school_performance_kpi/{semId}/schools/{schoolId}
    // Read:  academic_admin sees all; academic_user sees only their own school
    // Write: academic_admin always; academic_user only if their schoolId matches
    match /school_performance_kpi/{semId}/schools/{schoolId} {
      allow read: if isAHAdmin()
                  || (isAcademicUser()
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId);
      allow write: if isAHAdmin()
                   || (isAcademicUser()
                       && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId);
    }

    // -- ah_categories (Academic Hub dashboard category config) --
    // Read scope (Step 12 hardening — was previously open to any
    // academic_user, leaking gated category names via getDocs):
    //
    //   Per-doc (get / list-as-get):
    //     - AH admin / central_admin always
    //     - Any AH user can read a doc whose visible_to is empty (open)
    //     - Otherwise user's ah_sub_roles[] must intersect visible_to[]
    //
    // The client must filter at query level too (Firestore evaluates
    // `get` per doc inside a list query):
    //
    //   1. where('visible_to', '==', [])
    //        → fetches the open-to-all categories
    //   2. where('visible_to', 'array-contains-any', mySubRoles)
    //        → fetches the categories targeted at my sub-roles
    //
    // Combine both result sets client-side. Admins skip the dual query
    // and use a single unfiltered listener.
    match /ah_categories/{catId} {
      allow read:                   if isAHAdmin()
                                    || (isAcademicUser() && (
                                          !('visible_to' in resource.data)
                                          || resource.data.visible_to.size() == 0
                                          || (userProfile().ah_sub_roles is list
                                              && resource.data.visible_to.hasAny(userProfile().ah_sub_roles))
                                       ));
      allow create, update, delete: if isAHAdmin();
    }

    // -- th_resource_sections (Teachers Hub index resource sections) --
    // Same model as ah_categories above (admin / open / sub-role intersect).
    match /th_resource_sections/{secId} {
      allow read:                   if isTHAdmin()
                                    || (isTeachersUser() && (
                                          !('visible_to' in resource.data)
                                          || resource.data.visible_to.size() == 0
                                          || (userProfile().th_sub_roles is list
                                              && resource.data.visible_to.hasAny(userProfile().th_sub_roles))
                                       ));
      allow create, update, delete: if isTHAdmin();
    }

    // -- networkAudits (School Network Security Audit results) --
    match /networkAudits/{auditId} {
      allow create: if isAuthorized() && request.resource.data.testerUid == request.auth.uid;
      allow read:   if isAdmin() || (isAuthorized() && resource.data.testerUid == request.auth.uid);
      allow list:   if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // -- platform_usage (login analytics, written by all auth-guards) --
    match /platform_usage/{docId} {
      // Any authenticated user can write their own login event
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only central_admin can read (for analytics dashboard)
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // -- pathwaySubmissions (Cambridge Pathway Simulator - public) --
    match /pathwaySubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // -- orientation_resources (public handbook/video/book list) --
    // Read: anyone (no auth required — public orientation page)
    // Since 2026-05-20: create/update opened to CH central_user
    // (page-access gates /orientation-admin). Delete stays admin-only.
    match /orientation_resources/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- orientation_questions (competency quiz questions) --
    match /orientation_questions/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- orientation_registrations (submitted applications) --
    // Create: anyone (public form submission)
    // Read/update opened to CH central_user; delete stays admin-only.
    match /orientation_registrations/{docId} {
      allow create: if true;
      allow read, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- school_events (Partner Schools Event Calendar) ----------
    // Read: any authorized user
    // Write:
    //   - any Central Hub user (network-wide HQ access), OR
    //   - any Academic Hub user, but only for events at their own school
    //     (request.resource.data.schoolId must match userProfile().schoolId).
    //   AH creates also require createdBy == request.auth.uid so the audit
    //   trail stays honest; CH HQ users may write on behalf of any school.
    match /school_events/{eventId} {
      allow read:   if isAuthorized();
      allow create: if isCentralUser()
                    || (isAcademicUser()
                        && request.resource.data.schoolId == userProfile().schoolId
                        && request.resource.data.createdBy == request.auth.uid);
      allow update: if isCentralUser()
                    || (isAcademicUser()
                        && resource.data.schoolId == userProfile().schoolId
                        && request.resource.data.schoolId == userProfile().schoolId);
      allow delete: if isCentralUser()
                    || (isAcademicUser()
                        && resource.data.schoolId == userProfile().schoolId);
    }

    // -- cambridge_calendar (exam deadline dates per year+series) --
    // Read: any authorized user (AH, TH, CH all need to view)
    // Since 2026-05-20: write opened to CH central_user (page-access
    // gates /cambridge-calendar).
    match /cambridge_calendar/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin() || isCentralUser();
    }

    // -- school_visits (Visit & Audit Management) ------------
    // Read: any Central Hub user
    // Write (create/update/delete): central_admin only
    match /school_visits/{visitId} {
      // Read: any signed-in Central Hub user (Director / Specialist / Coord).
      // Write: any Central Hub user — Subject Specialists need to log their
      // own visit notes after going on-site; auditing relies on the
      // createdBy / visitedBy fields the page already writes. Phase 2 will
      // tighten this to "owner-only update + admin override" once the
      // schema gets a createdByUid field.
      allow read:                   if isCentralUser();
      allow create, update, delete: if isCentralUser();
    }

    // -- kpi_school_submissions (School KPI submissions reviewed by HQ) --
    // Read: central_admin reads all; academic_admin reads all;
    //       academic_user reads only their own school's submission
    // Write (create/update): academic_admin or academic_user for their own school
    // Status updates (approve/reject/under_review): central_admin only
    match /kpi_school_submissions/{submId} {
      allow read: if isAdmin() || isCentralUser() || isAHAdmin()
                  || (isAcademicUser()
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId);
      allow create: if isAHAdmin()
                    || (isAcademicUser()
                        && request.resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow update: if isAdmin() || isCentralUser()
                    || isAHAdmin()
                    || (isAcademicUser()
                        && resource.data.schoolId ==
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow delete: if isAdmin();
    }

    // -- announcement_reads (read-receipt tracking) ----------
    // Doc ID: {annId}__{uid}
    // Any authorized user can write their own read receipt; admin + CH
    // reviewers read all (read-receipt analytics).
    match /announcement_reads/{readId} {
      allow read:   if isAdmin() || isCentralUser();
      allow create, update: if isAuthorized()
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // -- teacher_contacts (Unregistered teacher mailing list) --
    // Since 2026-05-20: opened to CH central_user (page-access gates
    // /mail-composer). 463+ teacher addresses live here.
    // 2026-08-01 hardening: the 463-address network mailing list was
    // readable AND writable by any central_user via raw SDK. The only
    // consumers are /mail-composer (central_admin page) and the Railway
    // mail service (Admin SDK, bypasses rules) — admin-only now.
    match /teacher_contacts/{contactId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // -- mail_campaigns (Newsletter campaign history) --------
    // Written by Railway mail service via Admin SDK (bypasses rules).
    // Read opened to CH central_user for history table on /mail-composer.
    match /mail_campaigns/{campaignId} {
      allow read: if isAdmin() || isCentralUser();
      allow write: if false; // Admin SDK only
    }

    // -- mail_templates (Reusable newsletter templates) ------
    // Saved from mail-composer.html "Save as Template" action.
    // Since 2026-05-20: opened to CH central_user. System templates
    // (kind:'system') stay readable by any signed-in user for the
    // auth-guard.js / Cloud Function notification paths.
    match /mail_templates/{templateId} {
      allow get:    if isAdmin() || isCentralUser()
                    || (isAuthorized() && resource.data.kind == 'system');
      allow list:   if isAdmin() || isCentralUser();
      allow write:  if isAdmin() || isCentralUser();
    }

    // -- user_notes (Personal post-it / notepad) ---------------------
    // Each row has exactly one owner. By default a note is private
    // (`isPublic: false`) — only the owner reads. When the owner flips
    // `isPublic: true` the note becomes readable by every authorised
    // CH user (HQ-wide "Team Notes"). Edit/delete/upload always stay
    // owner-only — public is read-only sharing.
    //   - Create: signed-in caller must pin userId to their own auth.uid.
    //   - Get:    owner OR (isPublic == true AND any authorised user).
    //   - List:   client query MUST scope by either userId == auth.uid
    //             OR isPublic == true. Rule allows the read; query shape
    //             is what scopes it.
    //   - Update/Delete: owner only.
    match /user_notes/{noteId} {
      allow create: if isAuthorized()
                    && request.resource.data.userId == request.auth.uid;
      allow get:    if isAuthorized()
                    && (resource.data.userId == request.auth.uid
                        || resource.data.isPublic == true);
      allow list:   if isAuthorized();
      allow update: if isAuthorized()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthorized()
                    && resource.data.userId == request.auth.uid;
    }

    // -- competency_evidence (Teacher & Admin evidence submissions) --
    // Create:  the owner (any authorized teacher or academic user)
    // Read:    owner reads their own; central_admin reads all
    // Update:  central_admin only (to set status, reviewerNote, reviewedBy)
    // Delete:  central_admin only
    match /competency_evidence/{evId} {
      allow create: if isAuthorized()
                    && request.resource.data.userId == request.auth.uid;
      // Read: admin, any CH central_user (page-access gates /competency-admin),
      // or the owner reading their own submission.
      allow read:   if isAdmin() || isCentralUser()
                    || (isAuthorized() && resource.data.userId == request.auth.uid);
      // List: admin or any CH central_user (sayfaya giren listeleyebilir).
      // Owner-scoped lists from TH/AH are not supported here — those hubs
      // read individual docs by id.
      allow list:   if isAdmin() || isCentralUser();
      // Update: admin or any CH central_user (reviewer scope). Delete stays
      // admin-only — submissions are an audit trail.
      allow update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();

      // comments sub-collection: reviewer thread visible to owner and admins
      match /comments/{commentId} {
        allow read:   if isAdmin()
                      || (isAuthorized() && get(/databases/$(database)/documents/competency_evidence/$(evId)).data.userId == request.auth.uid);
        allow create: if isAdmin()
                      && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin();
        allow update: if false;
      }
    }

    // -- user_competencies (Per-user earned competency tracking) --
    // Doc ID = uid
    // User can read/write their own doc (for material done tracking).
    // Admin can read/write any doc (for approving earned levels).
    match /user_competencies/{uid} {
      // Owner reads/writes own doc; admin + CH reviewers read any.
      // 2026-08-01 hardening: cross-user WRITE narrowed to admin —
      // earned levels are approved from /competency-admin (admin tool);
      // any central_user being able to rewrite anyone's earned_*
      // fields broke the certification audit trail.
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin() || isCentralUser());
      allow write:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // -- content_overrides_academic (Admin-edited reading text for Academic Hub) --
    // Doc ID = "{compId}_{lvl}" e.g. "evsi-1_awareness"
    match /content_overrides_academic/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAHAdmin();
    }

    // -- content_overrides_teachers (Admin-edited reading text for Teachers Hub) --
    // Doc ID = "{compId}_{lvl}" e.g. "smc-1_awareness"
    match /content_overrides_teachers/{docId} {
      allow read:  if isAuthorized();
      allow write: if isTHAdmin();
    }

    // -- content_overrides_central (Admin-edited reading text for CH Specialist track) --
    // Doc ID = "{compId}_{lvl}" e.g. "csm-1_awareness"
    // Mirrors content_overrides_academic + content_overrides_teachers; central_admin
    // writes (XSS-sanitised client-side), every authorised user reads. Used by
    // /learning-path modal to overlay HQ-edited prose on the base level content
    // seeded into competency_framework/specialists/levels/{compId}_{lvl}.
    match /content_overrides_central/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAdmin();
    }

    // -- competency_certificates (Issued certificates) -------
    // Create:  central_admin only (issued via competency-admin.html)
    // Read:    owner reads their own; central_admin reads all
    // Update:  central_admin only (revoke flag)
    // Delete:  central_admin only
    match /competency_certificates/{certId} {
      // 2026-08-01 hardening: issue/revoke narrowed to admin —
      // /competency-admin is an admin tool, and any central_user being
      // able to mint or revoke certificates defeated the audit trail
      // (same precedent as scorecard immutability, Common Mistake #17).
      allow create: if isAdmin();
      allow read:   if isAdmin() || isCentralUser()
                    || (isAuthorized() && resource.data.userId == request.auth.uid);
      allow list:   if isAdmin() || isCentralUser();
      allow update: if isAdmin();
      // Delete: admin-only — certificates are an audit trail.
      allow delete: if isAdmin();
    }

    // -- framework_config (Admin-editable sample document links for appraisal framework) --
    // Read:  any authorized Academic Hub or Central Hub user
    // Write: academic_admin or central_admin only
    match /framework_config/{docId} {
      allow read:  if isAuthorized();
      allow write: if isAHAdmin();
    }

    // -- competency_framework (Eduversal competency tracks per audience) --
    // Doc ID: trackId — currently 'teachers' (TH), upcoming 'leaders' (AH),
    // 'specialists' (CH). Holds the 4-level × N-domain × M-competency
    // structure plus the verbatim Cambridge / Permendiknas reference text.
    // Read:  any authorized user (every TH/AH/CH page reads this)
    // Write: central_admin only — seeded via Admin SDK by
    //        scripts/competency/seed-{th,ah,ch}-competency-framework.js
    // -- cambridge_crossref (Phase 4 read-only aggregator) --
    // Single doc 'index' aggregates Cambridge Teacher Standards refs
    // across KPI / Appraisal / Competency so consumer pages can render
    // "this same Cambridge standard is also tracked in X, Y, Z" without
    // running 5+ separate queries on every chip hover.
    match /cambridge_crossref/{docId} {
      allow read:  if isAuthorized();
      // Aggregator built by scripts/competency/build-crossref-index.js
      // (Admin SDK). Client write opened to CH central_user for in-app
      // rebuild flows.
      allow write: if isAdmin() || isCentralUser();
    }

    match /competency_framework/{trackId} {
      // Public read: the framework root doc holds Cambridge / Permendiknas
      // verbatim reference text + the Eduversal domain/competency taxonomy.
      allow read:  if true;
      // Since 2026-05-20: write opened to CH central_user (page-access
      // gates /competency-framework + /competency-admin).
      allow write: if isAdmin() || isCentralUser();

      // Per-(competency, level) base learning content.
      match /levels/{levelDocId} {
        allow read:  if isAuthorized();
        allow write: if isAdmin() || isCentralUser();
      }
    }

    // -- calibration_sessions (Appraiser IRR calibration — Academic Hub) --
    // Doc ID: {userId}_{year}  e.g. "abc123_2025"
    // Read:   owner reads their own; academic_admin reads all (leaderboard)
    // Write:  owner only (setDoc with merge)
    match /calibration_sessions/{docId} {
      allow read:  if isAHAdmin()
                   || (isSignedIn() && isAcademicUser() && resource.data.userId == request.auth.uid);
      allow list:  if isAHAdmin();
      allow write: if isSignedIn() && isAcademicUser()
                   && request.resource.data.userId == request.auth.uid;
    }

    // -- calibration_group_sessions (Real-time group calibration sessions) --
    // Doc ID: 6-char session code (random)
    // Read:   any Academic Hub user (to join by code)
    // Create: any Academic Hub user (facilitator)
    // Update: any Academic Hub user (join as participant, submit scores)
    match /calibration_group_sessions/{sessionCode} {
      allow read:   if isSignedIn() && isAcademicUser();
      allow create: if isSignedIn() && isAcademicUser();
      allow update: if isSignedIn() && isAcademicUser();
    }

    // -- observation_calibration_sessions (Subject Specialist F2 calibration) --
    // Doc ID: 6-char session code (random, generated client-side)
    // CH page: /observation-calibration
    //
    // Training data ONLY. These scores are never appraisal records — nothing
    // here reaches specialist_observations, teacher_appraisals_v2, or any
    // teacher's file. The lesson case scored against is fictional
    // (docs/cross-module/observation-calibration-scenario-v1.json).
    //
    // Read:   any Central Hub user (to join by code + see the distribution)
    // Create: any Central Hub user (whoever facilitates the session)
    // Update: any Central Hub user (join, submit own scores, record anchors)
    // Delete: central_admin only
    //
    // Per-participant write isolation is deliberately NOT rule-enforced —
    // participants write into participants.{key} on a shared doc, and the
    // threat model here is a 10-person HQ team in one room, all @eduversal.org
    // staff. Same trust boundary as the 2026-05-20 role flattening.
    match /observation_calibration_sessions/{sessionCode} {
      allow read:   if isSignedIn() && isCentralUser();
      allow create: if isSignedIn() && isCentralUser();
      allow update: if isSignedIn() && isCentralUser();
      allow delete: if isAdmin();
    }

    // -- sidebar_config (Central Hub sidebar order) ----------
    // Read: any central hub user (to load their sidebar order)
    // Write: central_admin only
    match /sidebar_config/{docId} {
      allow read:  if isCentralUser();
      allow write: if isAdmin();
    }

    // -- page_access_config (per-page sub-role visibility config) --
    // Doc ID = clean URL slug (e.g. 'school-performance-kpi').
    // Read: any signed-in user (auth-guard.js needs to check on every page load).
    // Write: central_admin only (managed via console.html → Page Access Manager).
    match /page_access_config/{pageKey} {
      allow read:                   if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ===========================================================
    // INDUCTION MODULE (2026-05-04)
    // -----------------------------------------------------------
    // 7 collections that implement the Eduversal Induction Charter.
    // See docs/induction/INDUCTION_CHARTER.md and
    //     docs/induction/firestore-schema.json
    // for the full specification.
    //
    // Charter non-negotiables enforced here:
    //   NN1: Year-1 induction data never feeds network appraisal scoring.
    //        (induction_observations is its own collection — no propagation.)
    //   NN2: Mentee journal entries are visible to mentor + school leader
    //        only by mentee opt-in. HQ never reads named entries.
    //   NN3: No user without active Mentor Certification can be assigned
    //        as a mentor. Enforced in induction_assignments create rule.
    //   NN4: Induction assignment requires three named parties at create.
    //   NN5: Induction Completion Certificate is binary; written into
    //        the existing competency_certificates collection by the
    //        seeder/admin tool, not by these rules.
    // ===========================================================

    // Helper: read an induction assignment doc (composite uid PK).
    function inductionAssignment(menteeUid) {
      return get(/databases/$(database)/documents/induction_assignments/$(menteeUid)).data;
    }

    function inductionAssignmentExists(menteeUid) {
      return exists(/databases/$(database)/documents/induction_assignments/$(menteeUid));
    }

    // Helper: is the caller the assigned mentor of menteeUid?
    function isMentorOf(menteeUid) {
      return isSignedIn() &&
             inductionAssignmentExists(menteeUid) &&
             inductionAssignment(menteeUid).mentorUid == request.auth.uid;
    }

    // Helper: is the caller the assigned school leader of menteeUid?
    function isInductionSchoolLeaderOf(menteeUid) {
      return isSignedIn() &&
             inductionAssignmentExists(menteeUid) &&
             inductionAssignment(menteeUid).schoolLeaderUid == request.auth.uid;
    }

    // Helper: does the caller hold an active mentor_base certification?
    // Composite key: {uid}_mentor_base
    function hasActiveMentorCertification(uid) {
      return exists(/databases/$(database)/documents/mentor_certifications/$(uid + '_mentor_base')) &&
             get(/databases/$(database)/documents/mentor_certifications/$(uid + '_mentor_base')).data.active == true;
    }

    // -- induction_programs ----------------------------------
    // Handbook templates (subject_teacher, principal, specialist).
    // Read open: every mentee + mentor must read their program template.
    // Write central_admin only — populated by seed-induction-programs.js.
    match /induction_programs/{programId} {
      allow read:                   if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // -- induction_assignments -------------------------------
    // One doc per induction'd user. PK = mentee uid.
    // NN3 + NN4 enforced at create: mentor must have active certification,
    // and all three party uids (mentee, mentor, schoolLeader) must be set.
    match /induction_assignments/{menteeUid} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == menteeUid          // owner (mentee)
                       || isMentorOf(menteeUid)               // assigned mentor
                       || isInductionSchoolLeaderOf(menteeUid)// assigned school leader
                       || isAdmin()
                       || isCentralUser()                      // CH reviewers via /induction-admin
                    );
      // Since 2026-05-20: CH list + create/update opened to any central_user
      // who page-access has granted /induction-admin surface access. NN3
      // (active mentor certification) and NN4 (three named uids) still
      // enforced at create.
      allow list:   if isAdmin() || isCentralUser();
      allow create: if (isAdmin() || isCentralUser())
                    && request.resource.data.uid == menteeUid
                    && request.resource.data.mentorUid is string
                    && request.resource.data.mentorUid.size() > 0
                    && request.resource.data.schoolLeaderUid is string
                    && request.resource.data.schoolLeaderUid.size() > 0
                    && request.resource.data.programId is string
                    && hasActiveMentorCertification(request.resource.data.mentorUid);
      allow update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();   // rare; usually we transition to 'withdrew' instead
    }

    // -- induction_progress ----------------------------------
    // PK pattern: {uid}_{taskId}. Each doc records one task's state.
    // Owner can write self-owned tasks; mentor writes mentor-owned;
    // school leader writes school-leader-owned. We do not enforce
    // ownerRole-vs-actor mapping at the rule layer (that would require
    // reading the program doc on every write); the client UI gates the
    // action and the resource's completedBy / mentorSignedOffAt /
    // schoolLeaderSignedOffAt fields preserve the actor record.
    match /induction_progress/{progressId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.uid
                       || isMentorOf(resource.data.uid)
                       || isInductionSchoolLeaderOf(resource.data.uid)
                       || isAdmin()
                    );
      allow list:   if isAdmin();
      allow create: if isSignedIn() && (
                       request.auth.uid == request.resource.data.uid
                       || isMentorOf(request.resource.data.uid)
                       || isInductionSchoolLeaderOf(request.resource.data.uid)
                       || isAdmin()
                    );
      allow update: if isSignedIn() && (
                       request.auth.uid == resource.data.uid
                       || isMentorOf(resource.data.uid)
                       || isInductionSchoolLeaderOf(resource.data.uid)
                       || isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // -- principal_coaching_sessions -------------------------
    // Mentor (HQ Director) writes; coachee (principal) reads own.
    // Foundation Reps EXCLUDED from access (coaching confidentiality).
    // Doc id: {principalUid}_{YYYY-MM-DD}.
    // Logged sessions are immutable.
    //
    // Coaching confidentiality — director-only-write one-off exception
    // (2026-05-27). Source: docs/cross-module/principal-coaching-framework-v1.json → data_model.access_control →
    // foundation_representative "no_access (preserves coaching
    // confidentiality)". NOT an Induction Charter Non-Negotiable; that
    // label was wrong and was retired 2026-08-08.
    // The 2026-05-20 CH role flattening opened writes to any central_user
    // who reached the form via page-access. That left a privacy boundary
    // soft: a manually-crafted Firestore SDK write from a non-director
    // central_user (or a UI bypass) would succeed. Coaching confidentiality
    // is too sensitive to rely on UI gating alone, so writes are pinned to
    // ch_sub_roles ∈ {director} via isCHDirector(). admin still bypasses.
    // This is a deliberate exception to the flatten — every other CH
    // collection trusts page-access (root CLAUDE.md Common Mistake #51).
    match /principal_coaching_sessions/{sessionId} {
      // Read: coachee + mentor + admin only. Foundation Reps cannot get
      // an individual session even with the doc id (no rule branch for
      // same-school AH leadership — coaching is mentor-coachee private).
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.principalUid
                       || request.auth.uid == resource.data.mentorUid
                       || isAdmin()
                    );
      // List restricted to admin — non-admin must know the doc id (their
      // own principalUid_YYYY-MM-DD pattern). Discoverability via list
      // would let any central_user enumerate principal coaching history.
      allow list:   if isAdmin()
                    || (isSignedIn() && isCHDirector());
      // Director-only write (coaching-confidentiality exception, see above).
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.mentorUid
                    && isCHDirector();
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.mentorUid
                    && isCHDirector()
                    && resource.data.status != 'logged';
      allow delete: if isAdmin();
    }

    // -- principal_360_cycles --------------------------------
    // Each principal × cycle window has a cycles doc that gates whether
    // responses are accepted (status: 'planned' / 'open' / 'closed').
    // Created by central_admin or foundation_representative; read-open
    // to all auth users so respondents can verify the cycle exists.
    match /principal_360_cycles/{cycleId} {
      allow get:    if isSignedIn();
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);
      // Since 2026-05-20: create/update opened to CH central_user
      // (page-access gates /principal-360-admin to director).
      allow create, update: if isAdmin() || isCentralUser();
      allow delete: if isAdmin();
    }

    // -- principal_360_responses -----------------------------
    // Anonymous response docs — auto-id, no respondent uid persisted.
    // Respondent anonymity (Principal 360 Framework →
    // design_principles: "Anonymity is non-negotiable"): only
    // Cloud-Function-maintained aggregates expose any computed mean to a
    // human; raw response docs are list-blocked from ordinary clients.
    match /principal_360_responses/{respId} {
      // Reads: only admin (forensic). No list at all — even the principal
      // sees only the aggregated view via principal_360_aggregates.
      allow get:    if isAdmin();
      allow list:   if false;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // -- principal_360_aggregates ----------------------------
    // Cloud Function-maintained anonymous summary; the principal + the
    // appraiser read this once min_respondents threshold is met.
    match /principal_360_aggregates/{aggId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.principalUid
                       || isAHUserAtSameSchool(resource.data.principalUid)
                       || isAdmin()
                    );
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);
      allow create, update, delete: if isAdmin();
    }

    // -- principal_annual_appraisals -------------------------
    // Annual leadership appraisal — F1-F5 + F_LEAD weighted scoring,
    // composite + A-F band. Doc id: {principalUid}_{academicYear}.
    // Submitted docs are immutable.
    match /principal_annual_appraisals/{appraisalId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.principalUid
                       || request.auth.uid == resource.data.appraiserUid
                       || isAHUserAtSameSchool(resource.data.principalUid)
                       || isAdmin()
                    );
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.appraiserUid
                    && (isAHUserAtSameSchool(request.resource.data.principalUid)
                        || isAdmin());
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.appraiserUid
                    && resource.data.status != 'submitted';
      allow delete: if isAdmin();
    }

    // -- principal_observations ------------------------------
    // Annual / termly principal leadership observations using the
    // 8-foci × evidence-indicator rubric (principal-observation-
    // rubric-v1). Distinct from induction_observations:
    //   - induction_observations  → year-1 mentee observations (NN1)
    //   - principal_observations  → annual leadership evaluation;
    //                               feeds into principal_annual_appraisals
    //                               (Phase-2 module, not yet wired)
    //
    // Audience:
    //   - Observer (academic_admin / foundation_representative who is
    //     designated for the school) creates + updates.
    //   - Subject principal reads own.
    //   - Same-school AH leadership reads (school_principal +
    //     academic_coordinator + foundation_representative).
    //   - central_admin reads all (network audit).
    match /principal_observations/{obsId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.principalUid
                       || request.auth.uid == resource.data.observerUid
                       || isAHUserAtSameSchool(resource.data.principalUid)
                       || isAdmin()
                    );
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.observerUid
                    && (isAHUserAtSameSchool(request.resource.data.principalUid)
                        || isAdmin());
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.observerUid
                    && resource.data.status != 'submitted';
      allow delete: if isAdmin();
    }

    // -- induction_observations ------------------------------
    // Stage 3 monthly observations + Q4 formal evaluation.
    // NN1: this collection is induction-scope only; no propagation
    // into teacher_appraisal_results.
    // Auto-id docs; observerUid creates and updates until completedAt.
    match /induction_observations/{obsId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.menteeUid
                       || request.auth.uid == resource.data.observerUid
                       || isMentorOf(resource.data.menteeUid)
                       || isInductionSchoolLeaderOf(resource.data.menteeUid)
                       || isAdmin()
                    );
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);  // client filters by menteeUid or observerUid
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.observerUid
                    && (isMentorOf(request.resource.data.menteeUid)
                        || isInductionSchoolLeaderOf(request.resource.data.menteeUid)
                        || isAdmin());
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.observerUid;
      allow delete: if isAdmin();
    }

    // -- induction_journal -----------------------------------
    // NN2: mentee's most-protected collection.
    // Owner always read+write own. Mentor reads if visibility allows.
    // School leader reads only if visibility == mentee_mentor_school_leader.
    // central_admin NEVER reads named entries (rule blocks; HQ uses
    // induction_journal_aggregates for telemetry).
    match /induction_journal/{entryId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.uid
                       || (isMentorOf(resource.data.uid)
                           && (resource.data.visibility == 'mentee_and_mentor'
                               || resource.data.visibility == 'mentee_mentor_school_leader'))
                       || (isInductionSchoolLeaderOf(resource.data.uid)
                           && resource.data.visibility == 'mentee_mentor_school_leader')
                    );
      allow list:   if false;  // no listing — owner reads own; mentor reads via specific gets
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    // -- induction_pulses ------------------------------------
    // Weekly 1-question pulses. Anonymised at HQ aggregate level.
    // Owner write; mentor + school leader read; HQ only via aggregates.
    match /induction_pulses/{pulseId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.uid
                       || isMentorOf(resource.data.uid)
                       || isInductionSchoolLeaderOf(resource.data.uid)
                    );
      allow list:   if isSignedIn() && request.auth.uid != null;  // client filters by uid or schoolId
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow delete: if isAdmin();
    }

    // -- mentor_certifications -------------------------------
    // Mentor Certification ledger. PK: {uid}_{certificationType}.
    // NN3: assignment rule reads this collection.
    // Read: owner + central_admin + AH school leaders (to verify
    // candidates within their school).
    match /mentor_certifications/{certId} {
      allow get:    if isSignedIn() && (
                       resource.data.uid == request.auth.uid
                       || isAdmin()
                       || isCentralUser()    // CH reviewers via /induction-admin
                       || isAcademicUser()   // AH school leaders need to verify mentor candidates
                    );
      // 2026-08-01 hardening: issue/revoke narrowed back to admin.
      // This collection is Charter NN3's gate — induction_assignments
      // creation REQUIRES an active mentor cert, so letting any
      // central_user mint certs made NN3 self-defeating. Certs are
      // issued from /induction-admin (central_admin page).
      allow list:   if isAdmin() || isCentralUser() || isAcademicUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -- induction_journal_aggregates ------------------------
    // Cloud-Function-maintained anonymous aggregates for HQ telemetry.
    // No client writes (all writes from a server-side Cloud Function
    // with admin SDK, which bypasses these rules). Read open since
    // there is no PII.
    match /induction_journal_aggregates/{aggId} {
      allow read:           if isSignedIn();
      allow create, update, delete: if false;  // server-only via Cloud Function
    }

    // -- induction_alarms ------------------------------------
    // Cloud-Function-maintained alarm docs. Created by onPulseWritten
    // when a mentee records 2 consecutive low-pulse weeks. Read by the
    // assigned mentor + school leader + central_admin so the in-school
    // pair can intervene within 7 days per the Charter.
    // PK: {uid}_{weekStartDate}.
    match /induction_alarms/{alarmId} {
      allow get:    if isSignedIn() && (
                       request.auth.uid == resource.data.uid
                       || request.auth.uid == resource.data.mentorUid
                       || request.auth.uid == resource.data.schoolLeaderUid
                       || isAdmin()
                    );
      allow list:   if isAdmin()
                    || (isSignedIn() && request.auth.uid != null);  // client filters by mentorUid or schoolLeaderUid
      allow update: if isSignedIn() && (
                       request.auth.uid == resource.data.mentorUid
                       || request.auth.uid == resource.data.schoolLeaderUid
                       || isAdmin()
                    );
      allow create, delete: if false;  // server-only via Cloud Function
    }

    // -- topics (message board) ------------------------------
    match /topics/{topicId} {
      allow read:   if isAuthorized();
      allow create: if isAuthorized();
      // Author / admin / CH coordinator can do full updates; any authorised user
      // can bump replyCount only (so non-author repliers keep the count in sync
      // after addDoc to /replies).
      allow update: if isAuthorized() && (
                       resource.data.authorUid == request.auth.uid
                    || isAdmin()
                    || isCHCoordinator()
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['replyCount']));
      // Delete stays restricted to author + admin (coordinator excluded).
      allow delete: if isAuthorized() && (resource.data.authorUid == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow read:   if isAuthorized();
        allow create: if isAuthorized();
        // Author can edit/delete own; admin can do either; coordinator can edit
        // but not delete (mirrors topic-level rule).
        allow update: if isAuthorized() &&
                         (resource.data.authorUid == request.auth.uid || isAdmin() || isCHCoordinator());
        allow delete: if isAuthorized() &&
                         (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // ========================================================
    // CAREERS + INTERVIEW MODULE (Teachers Hub /careers)
    // Public application form + auth'd interviewer scoring
    // ========================================================

    // Helpers — TH sub-role checks based on th_sub_roles[] array
    function hasTHSubRole(roleName) {
      return isAuthorized()
             && ('th_sub_roles' in userProfile())
             && userProfile().th_sub_roles is list
             && userProfile().th_sub_roles.hasAny([roleName]);
    }
    function isInterviewer()      { return hasTHSubRole('interviewer'); }
    function isHiringManager()    { return hasTHSubRole('hiring_manager'); }
    // Hiring power: central_admin OR teachers_admin OR hiring_manager sub-role
    function hasHiringPower() {
      return isAdmin() || isTHAdmin() || isHiringManager();
    }

    // -- job_positions (HQ-published vacancies) --------------
    // Read: open positions are public (no auth); admin + hiring power can read all incl. drafts
    match /job_positions/{posId} {
      allow get:    if (resource.data.status == 'open')
                    || isAdmin() || isTHAdmin() || isHiringManager();
      allow list:   if (request.query.limit <= 200)
                    && (
                         // public list query — must filter by status==open (rule trusts client query)
                         true
                       );
      allow create, update: if isAdmin() || isTHAdmin()
                          || (isHiringManager()
                              && request.resource.data.schoolId == userProfile().schoolId);
      allow delete: if isAdmin();
    }

    // -- interview_question_sets (rubric + 18 questions) -----
    // Read: any signed-in user (interviewers need access; applicants don't)
    match /interview_question_sets/{setId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isTHAdmin();
    }

    // -- job_applications (candidate submissions) ------------
    match /job_applications/{appId} {
      // PUBLIC create — anyone can submit. Validate required fields + email shape.
      // Status forced to 'submitted' on create; applicantToken required.
      allow create: if request.resource.data.keys().hasAll(
                         ['positionId','applicantEmail','applicantToken','applicant','status','source'])
                    && request.resource.data.applicantEmail is string
                    && request.resource.data.applicantEmail.matches('.+@.+\\..+')
                    && request.resource.data.applicantToken is string
                    && request.resource.data.applicantToken.size() >= 32
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.source == 'careers';

      // Read: admin / hiring_manager (own school) / interviewer (only assigned)
      // / applicant (own — matched by Firebase Auth verified email)
      allow get:    if isAdmin() || isTHAdmin()
                    || (isHiringManager() && resource.data.schoolId == userProfile().schoolId)
                    || (isInterviewer()
                        && resource.data.interviewSchedule.interviewerUids.hasAny([request.auth.uid]))
                    || (isSignedIn()
                        && request.auth.token.email_verified == true
                        && request.auth.token.email == resource.data.applicantEmail);
      allow list:   if isAdmin() || isTHAdmin() || isHiringManager()
                    // applicant's own list (client filters by applicantEmail==own)
                    || (isSignedIn()
                        && request.auth.token.email_verified == true
                        && request.query.limit <= 50);

      // Update: admin / hiring_manager (own school) / applicant (withdraw only)
      allow update: if isAdmin() || isTHAdmin()
                    || (isHiringManager() && resource.data.schoolId == userProfile().schoolId)
                    || (isSignedIn()
                        && request.auth.token.email_verified == true
                        && request.auth.token.email == resource.data.applicantEmail
                        && request.resource.data.status == 'withdrew'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','updatedAt']));
      allow delete: if false;
    }

    // -- interview_scorecards ({appId}_{interviewerUid}) ------
    match /interview_scorecards/{scId} {
      // Create/update: only the scoring interviewer themselves (uid match);
      // submitted docs are immutable (status can't go back from submitted).
      allow create: if isSignedIn()
                    && (isInterviewer() || hasHiringPower())
                    && request.resource.data.interviewerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && (isInterviewer() || hasHiringPower())
                    && request.resource.data.interviewerUid == request.auth.uid
                    && resource.data.interviewerUid == request.auth.uid
                    && (resource.data.status != 'submitted'
                        || (request.resource.data.status == 'submitted'
                            && resource.data.status == 'submitted'
                            // when already submitted, the only allowed write keeps status=submitted
                            // (no-op style) — block content edits after submit
                            && request.resource.data.diff(resource.data).affectedKeys().size() == 0));

      allow get:    if isAdmin() || isTHAdmin()
                    || (isHiringManager() && resource.data.schoolId == userProfile().schoolId)
                    || (isSignedIn() && resource.data.interviewerUid == request.auth.uid);
      allow list:   if isAdmin() || isTHAdmin() || isHiringManager()
                    // interviewer can list own scorecards (client filters by interviewerUid)
                    || (isInterviewer() && request.query.limit <= 50);
      allow delete: if false;
    }

    // -- job_application_audit (status change log) -----------
    match /job_application_audit/{auditId} {
      allow create: if isSignedIn() && hasHiringPower();
      allow read:   if isAdmin() || isTHAdmin() || isHiringManager();
      allow update, delete: if false;
    }

    // -- mail (RETIRED Firebase Trigger Email extension queue) --
    // The Trigger Email path was retired 2026-05-06 (all sends go through
    // the Resend mail-service). The old `allow create: if <shape-check>`
    // let ANYONE on the internet enqueue mail from our verified domain —
    // closed in the 2026-08-01 pre-launch hardening. Kept admin-readable
    // for forensics only.
    match /mail/{mailId} {
      allow create: if false;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // -- client_errors (global error-reporter sink, 2026-08-01) --
    // Written by the window.onerror / unhandledrejection hook in each
    // hub's auth-guard so production breakage is visible to HQ without
    // user reports. Size-capped to prevent abuse; uid pinned to the
    // caller; admin-only read + delete; append-only.
    match /client_errors/{errId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 300
                    && (!('stack' in request.resource.data)
                        || (request.resource.data.stack is string
                            && request.resource.data.stack.size() <= 4000))
                    && (!('ua' in request.resource.data)
                        || (request.resource.data.ua is string
                            && request.resource.data.ua.size() <= 400));
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // -- fn_rate_limits (Cloud-Function-only, 2026-08-01) --------
    // Per-user token buckets maintained by enforcePerUserRateLimit()
    // in functions/index.js (easeBankProxy / practiceBankAiSuggest /
    // askEduversal). Admin SDK bypasses rules; clients get nothing.
    match /fn_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // AI COMPETENCY FRAMEWORK v1.0 — Phase 2 (2026-05-17)
    //   See docs/architecture/FIRESTORE_SCHEMA.md §24 + the
    //   manifest at docs/research/eduversal/ai-competency-framework/.
    //
    //   Three collections:
    //     - ai_competency_self_assessments (per-teacher annual)
    //     - ai_maturity_assessments        (per-school annual)
    //     - ai_competency_aggregates       (CF-only summaries)
    //
    //   Boundary: these are PARALLEL to KPI / Appraisal / Competency
    //   rating systems. AICF docs never write into those collections
    //   and vice-versa.
    // ─────────────────────────────────────────────────────────

    // Helper: any signed-in central_user (admin or otherwise). Since
    // 2026-05-20, AI Maturity reviewer scope is gated solely by
    // page-access — admin manages who sees /ai-maturity-admin via
    // page_access_config.visible_to[]. Any central_user who reaches
    // the page can validate maturity levels and write back.
    function isAICFReviewer() {
      return isAdmin() || isCentralUser();
    }

    // Helper: is the requester an AH line-manager (school_principal /
    // academic_admin) at the same school as the target user?
    function isAHLineManagerForUser(targetUid) {
      return isAcademicUser()
          && get(/databases/$(database)/documents/users/$(targetUid)).data.schoolId ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role_academichub == 'academic_admin'
            || (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles is list
              && 'school_principal' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles
            )
          );
    }

    // -- ai_competency_self_assessments ----------------------
    // Per-teacher annual self-assessment of Eduversal AICF v1.0
    // Part 1. PK pattern: {userId}_{academicYear} (e.g.
    // abc123_2026-2027). Submit-and-validate workflow:
    //   draft  → submitted    (owner self-writes)
    //   submitted → validated (line manager writes validation.*)
    //
    // Read scope:
    //   - owner (always)
    //   - same-school AH school_principal / academic_admin (line manager)
    //   - CH director / coordinator / admin (network-wide)
    //
    // Write scope:
    //   - owner: CREATE + UPDATE while status == 'draft' (full doc)
    //   - owner: flip status 'draft' → 'submitted' (one-way; locks ratings + reflection fields)
    //   - line manager: write validation.* + flip status 'submitted' → 'validated'
    //                   (all other fields immutable)
    //   - central_admin: delete (forensic)
    match /ai_competency_self_assessments/{docId} {

      // Read: owner OR line manager OR CH reviewer.
      // The resource's userId field identifies the assessor.
      allow get: if isSignedIn() && (
                   request.auth.uid == resource.data.userId
                   || isAICFReviewer()
                   || isAHLineManagerForUser(resource.data.userId)
                 );

      // List: AH leadership over their own school + CH reviewers.
      // Clients filter by (schoolId == ownSchoolId) + (academicYear == ...)
      // which the indexes support.
      allow list: if isAICFReviewer() || isAcademicUser();

      // Owner self-CREATE: must claim own userId, set status to 'draft',
      // and not pre-populate validation.* fields.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'draft'
                    && !('validation' in request.resource.data);

      // UPDATE — split by what the writer is allowed to touch.
      allow update: if isSignedIn() && (
        // Path 1: owner self-update while draft (any field except validation.*)
        (
          request.auth.uid == resource.data.userId
          && resource.data.status == 'draft'
          && (!('validation' in request.resource.data) || request.resource.data.validation == resource.data.get('validation', null))
          && request.resource.data.userId == resource.data.userId
        )
        // Path 2: owner submit (draft → submitted; locks ratings + reflection)
        || (
          request.auth.uid == resource.data.userId
          && resource.data.status == 'draft'
          && request.resource.data.status == 'submitted'
          && request.resource.data.ratings == resource.data.ratings
          && request.resource.data.selfDeclaredLevel == resource.data.selfDeclaredLevel
        )
        // Path 3: line manager validation (submitted → validated; only validation.* + status)
        || (
          (isAICFReviewer() || isAHLineManagerForUser(resource.data.userId))
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'validated'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.ratings == resource.data.ratings
          && request.resource.data.selfDeclaredLevel == resource.data.selfDeclaredLevel
          && request.resource.data.strengths == resource.data.strengths
          && request.resource.data.growthAreas == resource.data.growthAreas
          && request.resource.data.professionalLearningGoals == resource.data.professionalLearningGoals
        )
        // Path 4: central_admin override (forensic / unblocking — rare)
        || isAdmin()
      );

      // Delete: central_admin only.
      allow delete: if isAdmin();
    }

    // -- ai_maturity_assessments -----------------------------
    // Per-school annual institutional maturity self-assessment.
    // PK pattern: {schoolId}_{academicYear}. Validated by CH
    // Academic Directorate during the appraisal visit.
    //
    // Read scope:
    //   - same-school AH leadership (school_principal, academic_coordinator,
    //     foundation_representative, academic_admin)
    //   - CH director / coordinator / admin (network-wide)
    //
    // Write scope:
    //   - school side: CREATE + UPDATE while status ∈ {'draft','submitted'}
    //     by AH school_principal / academic_admin at the school
    //     OR central_admin (network-wide rare).
    //   - appraiser: CH director / central_admin writes appraisal.*
    //     + flips status to 'appraised'. Other fields immutable.
    //   - delete: central_admin only.
    match /ai_maturity_assessments/{docId} {

      // Read: same-school AH leadership + CH reviewers.
      allow get: if isSignedIn() && (
                   isAICFReviewer()
                   || (
                     isAcademicUser()
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
                   )
                 );

      // List: AH leadership over their own school + CH reviewers.
      // Clients filter by schoolId or academicYear which indexes support.
      allow list: if isAICFReviewer() || isAcademicUser();

      // CREATE: AH school_principal / academic_admin for own school,
      // or central_admin. Must claim submittedBy = self + schoolId matches.
      allow create: if isSignedIn()
                    && request.resource.data.submittedBy == request.auth.uid
                    && request.resource.data.status in ['draft', 'submitted']
                    && !('appraisal' in request.resource.data)
                    && (
                      isAdmin()
                      || (
                        isAcademicUser()
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == request.resource.data.schoolId
                        && (
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role_academichub == 'academic_admin'
                          || (
                            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles is list
                            && 'school_principal' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles
                          )
                        )
                      )
                    );

      // UPDATE: split by what the writer is allowed to touch.
      allow update: if isSignedIn() && (
        // Path 1: school-side update while draft or submitted (not appraised yet,
        // appraisal.* must remain unchanged / absent)
        (
          resource.data.status in ['draft', 'submitted']
          && (!('appraisal' in request.resource.data) || request.resource.data.appraisal == resource.data.get('appraisal', null))
          && request.resource.data.schoolId == resource.data.schoolId
          && (
            isAdmin()
            || (
              isAcademicUser()
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
              && (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role_academichub == 'academic_admin'
                || (
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles is list
                  && 'school_principal' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ah_sub_roles
                )
              )
            )
          )
        )
        // Path 2: appraiser writes appraisal.* + flips status to 'appraised'.
        // domainRatings + other fields immutable at this stage.
        || (
          isAICFReviewer()
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'appraised'
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.domainRatings == resource.data.domainRatings
          && request.resource.data.priorityActions == resource.data.priorityActions
        )
        // Path 3: central_admin override (forensic).
        || isAdmin()
      );

      // Delete: central_admin only.
      allow delete: if isAdmin();
    }

    // -- ai_competency_aggregates ---------------------------
    // Read-only summaries maintained by Cloud Function
    // `rebuildAiCompetencyAggregates` (Phase 3 deploy). Two PK
    // namespaces:
    //   {schoolId}_{academicYear}  — school-level (read by AH + CH)
    //   network_{academicYear}     — network-level (CH only)
    match /ai_competency_aggregates/{aggregateId} {

      // Read: same-school AH leadership + CH reviewers (school-level);
      //       CH reviewers only (network-level).
      allow get: if isSignedIn() && (
                   isAICFReviewer()
                   || (
                     resource.data.scopeKind == 'school'
                     && isAcademicUser()
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
                   )
                 );

      // List: CH reviewers always; AH leadership for school-scope docs.
      allow list: if isAICFReviewer() || isAcademicUser();

      // No client writes — Cloud Function only.
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // DEPARTMENT OFFICE (2026-05-19)
    //
    // HQ Director + Subject Coordinator workspace replacing the
    // long-running Google Docs "Heads of Departments — Meeting
    // Records" workflow. Four collections, all HQ-internal:
    //
    //   - coordinators_meetings            Weekly + ad-hoc minutes
    //   - coordinators_meeting_items       Per-meeting agenda items
    //   - department_artifacts             Per-subject living docs
    //                                      (Annual Plan / DTP /
    //                                      Department Handbook /
    //                                      Subject Policy)
    //   - coordinators_decisions           Binding policy / decision
    //                                      register (red-text from
    //                                      minutes promoted here)
    //   - coordinators_directory_entries   Subject Coordinators +
    //                                      per-school Subject Leaders
    //                                      + per-grade Grade Coords
    //
    // Audience: central_admin + ch_sub_roles ∈ {director, coordinator}.
    // No school-side reads. No student-side reads ever.
    //
    // Coordinators see all docs (cross-subject visibility is the
    // point of the workspace); client-side filtering by ch_subjects[]
    // is a UX nicety only. Director + admin bypass any filter.
    //
    // Activity bridge: meeting agenda items may set
    //   activityTaskId: '<activity_tasks/{id}>'
    // pointing at an /activities task spawned from the agenda. The
    // task itself lives under the existing activity_projects /
    // activity_tasks rules — these collections never duplicate it.
    // ─────────────────────────────────────────────────────────

    // Helper: any signed-in central_user (admin or otherwise). Since
    // 2026-05-20 the "department office" scope is gated solely by
    // page-access — admin manages who sees /coordinators-meetings,
    // /decisions-register, /coordinators-directory, /department-artifacts
    // via page_access_config.visible_to[]. Any central_user who reaches
    // those pages can read + write the underlying collections.
    function isDeptOfficeMember() {
      return isAdmin() || isCentralUser();
    }

    match /coordinators_meetings/{meetingId} {
      allow get, list:        if isDeptOfficeMember();
      // Create: any dept-office member; createdBy must pin to the
      // caller so future audit / "edited-by" UI is honest.
      allow create:           if isDeptOfficeMember()
                                 && request.resource.data.createdBy == request.auth.uid;
      // Update: any dept-office member can amend any meeting
      // (collaborative editing, mirroring the G-Docs pattern); admin
      // can additionally rewrite createdBy if needed for a clean-up.
      allow update:           if isDeptOfficeMember();
      // Delete: admin only — minutes are an audit trail.
      allow delete:           if isAdmin();
    }

    // Per-meeting agenda items live as a TOP-LEVEL collection rather
    // than a sub-collection so we can query agenda_items across all
    // meetings (e.g. "find every item tagged decision in the last 90
    // days" for the decisions-register feeder query). FK to parent
    // meeting is the `meetingId` field.
    match /coordinators_meeting_items/{itemId} {
      allow get, list:        if isDeptOfficeMember();
      allow create, update:   if isDeptOfficeMember();
      allow delete:           if isAdmin() || (isDeptOfficeMember()
                                 && resource.data.createdBy == request.auth.uid);
    }

    match /department_artifacts/{artifactId} {
      allow get, list:        if isDeptOfficeMember();
      allow create, update:   if isDeptOfficeMember();
      allow delete:           if isAdmin();
    }

    // Binding decisions / policies surfaced from minutes (and
    // sometimes authored directly). status field gates UI display
    // (active / superseded / draft). Source-meeting back-link via
    // sourceMeetingId + sourceItemId is optional — admin-authored
    // policies (e.g. dress code) may have no source meeting.
    match /coordinators_decisions/{decisionId} {
      allow get, list:        if isDeptOfficeMember();
      allow create, update:   if isDeptOfficeMember();
      // Decisions are intentionally immutable from the UI once
      // marked status:'active'; supersede by writing a new decision
      // pointing at this one via supersedesDecisionId. Admin can
      // still hard-delete for typo / draft cleanup.
      allow delete:           if isAdmin();
    }

    // RFC / Proposals board (2026-05-29). The deliberation layer that
    // sits BEFORE a binding decision — coordinators discuss strategic
    // topics (KPI weighting, MAP Testing, Diagnostic Tests) in phases
    // (draft → open_for_comment → decided / parked). Promoting a
    // proposal writes a coordinators_decisions doc with a back-link
    // (sourceProposalId) and flips the proposal phase to 'decided'.
    // Phase + promote authority is a Director UX courtesy enforced in
    // the page JS only — the rule trusts any dept-office member, same
    // as the rest of the office collections (2026-05-20 model).
    match /coordinator_proposals/{proposalId} {
      allow get, list:        if isDeptOfficeMember();
      allow create, update:   if isDeptOfficeMember();
      allow delete:           if isAdmin();
    }

    // Threaded discussion on a proposal. Top-level (not a sub-collection)
    // so the page can subscribe by proposalId. A commenter may delete
    // their own comment (the page decrements the parent commentCount);
    // admin can delete any.
    match /coordinator_proposal_comments/{commentId} {
      allow get, list:        if isDeptOfficeMember();
      allow create:           if isDeptOfficeMember()
                                 && request.resource.data.authorUid == request.auth.uid;
      allow update, delete:   if isAdmin() || (isDeptOfficeMember()
                                 && resource.data.authorUid == request.auth.uid);
    }

    // Coordinators Directory — Eduversal Subject Coordinators (CH)
    // plus per-school Subject Leaders + per-grade Grade Coordinators.
    // entryKind discriminates: 'hq_coordinator' | 'school_subject_leader' | 'grade_coordinator'.
    // Read-open to dept-office members; admin-only write keeps the
    // directory canonical. Since 2026-05-20 write opened to any
    // central_user whom page-access has granted access to
    // /coordinators-directory — admin manages who curates via
    // page_access_config.visible_to[].
    match /coordinators_directory_entries/{entryId} {
      allow get, list:        if isDeptOfficeMember();
      allow create, update, delete:
                              if isAdmin() || isCentralUser();
    }

    // ─────────────────────────────────────────────────────────────
    // Department Workspace free-text notes (2026-05-24)
    //
    // department_notes/{subjectId}/sections/{sectionId}
    //   - subjectId  ∈ ch_subjects enum
    //                  (math, biology, chemistry, physics, science,
    //                   english, bahasa, religion, edu_steam)
    //   - sectionId  free-text section key — first one shipped is
    //                'discussion_topics' (Coordinator's running list
    //                of items to raise with school subject leaders).
    //
    // Boundary:
    //   - Read: loose — any signed-in central_user can read any
    //     department's notes (network transparency, matches the four
    //     existing Department Office cross-views).
    //   - Write: subject-scoped — admin + director bypass; otherwise
    //     the caller's users/{uid}.ch_subjects[] must include the
    //     subjectId in the path. Plain central_user without the
    //     subject cannot edit; they get the read-only view in UI.
    function isSubjectOwner(subjectId) {
      return isCentralUser()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            ('ch_sub_roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             && 'director' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ch_sub_roles)
            ||
            ('ch_subjects' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
             && subjectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ch_subjects)
          );
    }

    match /department_notes/{subjectId} {
      // Parent doc is optional — used as a flat aggregate stamp if anything
      // ever needs a quick "any notes touched on this subject" probe.
      allow get, list: if isDeptOfficeMember();
      allow create, update: if isAdmin() || isSubjectOwner(subjectId);
      allow delete: if isAdmin();

      match /sections/{sectionId} {
        allow get, list: if isDeptOfficeMember();
        // CREATE pins subjectId + sectionId to the path so a coordinator
        // can't shadow someone else's section.
        allow create: if (isAdmin() || isSubjectOwner(subjectId))
                         && request.resource.data.subjectId == subjectId
                         && request.resource.data.sectionId == sectionId;
        allow update: if (isAdmin() || isSubjectOwner(subjectId))
                         && request.resource.data.subjectId == subjectId
                         && request.resource.data.sectionId == sectionId;
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // PROGRAMME NOTES (2026-07-24) — free-text G-Docs-style pad per
    // programme hub (/ease-growth, …). programKey scopes the doc, NOT a
    // subject, so this deliberately does NOT reuse isSubjectOwner()
    // (which is director/subject-gated). Permissive to match the rest of
    // the programme-hub ecosystem: any Department Office member (admin ||
    // central_user) reads AND writes. Page-access is the real gate.
    // programme_notes/{programKey}/sections/{sectionId}
    match /programme_notes/{programKey} {
      allow get, list: if isDeptOfficeMember();
      allow create, update: if isDeptOfficeMember();
      allow delete: if isAdmin();

      match /sections/{sectionId} {
        allow get, list: if isDeptOfficeMember();
        // CREATE/UPDATE pin programKey + sectionId to the path so a writer
        // can't shadow another programme's section.
        allow create: if isDeptOfficeMember()
                         && request.resource.data.programKey == programKey
                         && request.resource.data.sectionId == sectionId;
        allow update: if isDeptOfficeMember()
                         && request.resource.data.programKey == programKey
                         && request.resource.data.sectionId == sectionId;
        allow delete: if isAdmin();
      }
    }

    // ═════════════════════════════════════════════════════════════
    // ACADEMIC HUB SCHOOL LEADERSHIP WORKSPACE (2026-05-21)
    // ─────────────────────────────────────────────────────────────
    // Mirrors CH Coordinators (Department Office) but school-scoped.
    // Audience: Foundation Representative + School Principal +
    // Academic Coordinator + Cambridge Coordinator at the SAME
    // school. academic_admin + central_admin bypass via isAHAdmin().
    //
    // Every record carries `schoolId` (REQUIRED) and rules enforce
    // same-school scoping via isAHSchoolLeader(schoolId). The
    // page-access UI further refines which sub-roles see each page;
    // rule layer just gates the network primitive.
    //
    // Collections in this block:
    //   school_leadership_meetings        — minutes envelope
    //   school_leadership_meeting_items   — agenda items (top-level FK)
    //   school_leadership_decisions       — binding school policies
    //   school_leadership_directory_entries — leadership team contact list
    //   school_artifacts                  — per-subject artifacts
    //                                       (annual plan / handbook / policy)
    //   school_activity_projects          — kanban project envelopes
    //   school_activity_tasks             — kanban tasks (FK to project)
    // ═════════════════════════════════════════════════════════════

    match /school_leadership_meetings/{meetingId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      // Delete: admin only — minutes are an audit trail.
      allow delete:     if isAHAdmin();
    }

    // Top-level so we can query agenda items across meetings
    // (e.g. "find every action-tagged item from last 90 days").
    // FK to parent meeting via `meetingId`. Records also carry
    // `schoolId` for same-school filtering on list queries.
    match /school_leadership_meeting_items/{itemId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin()
                           || (isAHSchoolLeader(resource.data.schoolId)
                               && resource.data.createdBy == request.auth.uid);
    }

    // Binding school-level policies. Source meeting link is optional
    // (admin-authored policies may not have one). Active decisions
    // should be superseded via supersededByDecisionId rather than
    // edited in place (UI enforces; rule allows update for now).
    match /school_leadership_decisions/{decisionId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin();
    }

    // RFC / Proposals board (2026-05-29) — the deliberation layer that
    // sits BEFORE a school decision. Same school-scoped pattern as
    // school_leadership_decisions. Phase + promote authority is a School
    // Principal UX courtesy enforced in page JS only — the rule trusts any
    // same-school leader. Promoting writes a school_leadership_decisions doc
    // (sourceProposalId back-link) and flips proposal phase to 'decided'.
    match /school_leadership_proposals/{proposalId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin();
    }

    // Threaded discussion on a proposal. Top-level (not a sub-collection)
    // so the page subscribes by proposalId. Carries schoolId for the
    // same-school scope check. A commenter may delete their own comment;
    // admin can delete any.
    match /school_leadership_proposal_comments/{commentId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.authorUid == request.auth.uid);
      allow update, delete:
                        if isAHAdmin()
                           || (isAHSchoolLeader(resource.data.schoolId)
                               && resource.data.authorUid == request.auth.uid);
    }

    match /school_leadership_directory_entries/{entryId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      // Any school leader can curate the directory (entries are
      // routine HR-style records, not sensitive evaluation data).
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update, delete:
                        if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
    }

    // Per-(school, subject) living documents. Versioning via
    // previousVersionId chain; exactly one status:'current' per
    // (schoolId, subjectId, artifactType, academicYear) tuple
    // enforced by the UI (not by rule).
    match /school_artifacts/{artifactId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin();
    }

    // School-scoped kanban (mirrors network-scoped /activity_projects
    // + /activity_tasks but per-school). Same-school read + write for
    // every leadership member.
    match /school_activity_projects/{projectId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin();
    }

    match /school_activity_tasks/{taskId} {
      allow get, list:  if isAHAdmin()
                           || (resource != null && isAHSchoolLeader(resource.data.schoolId));
      allow create:     if isAHAdmin()
                           || (isAHSchoolLeader(request.resource.data.schoolId)
                               && request.resource.data.createdBy == request.auth.uid);
      // Any school leader can update status / assignee / dueDate
      // (collaborative kanban). createdBy/schoolId/projectId pinned by UI.
      allow update:     if isAHAdmin()
                           || isAHSchoolLeader(resource.data.schoolId);
      allow delete:     if isAHAdmin()
                           || (isAHSchoolLeader(resource.data.schoolId)
                               && resource.data.createdBy == request.auth.uid);
    }

    // ==========================================================
    // PUBLISHED DASHBOARDS (2026-07-13)
    // ----------------------------------------------------------
    // Self-serve HTML dashboard publishing. Any signed-in CH user
    // uploads a single-page HTML file (stored in Firebase Storage at
    // published_dashboards/{id}/index.html) and gets a shareable link.
    // The HTML is NEVER executed in the CH origin — the viewer page
    // (/dashboard-view) renders it inside a sandboxed <iframe srcdoc>
    // WITHOUT allow-same-origin, so a malicious/careless <script> in an
    // uploaded file can't touch CH's Firebase session, cookies, or DOM.
    //
    // visibility ∈ {'public','ch_only','private'}:
    //   public   — anyone (login-less shareable link)
    //   ch_only  — any signed-in user (the doc is only reachable via CH,
    //              which is @eduversal.org-gated; no per-role check needed)
    //   private  — owner only
    // Default (set by the UI) is 'public'. Owner + central_admin manage.
    match /published_dashboards/{dashboardId} {
      function dashOwner() {
        return resource != null && resource.data.ownerUid == request.auth.uid;
      }
      allow get: if (resource != null && resource.data.visibility == 'public')
                    || (isSignedIn() && resource != null
                        && resource.data.visibility == 'ch_only')
                    || (isSignedIn() && dashOwner());
      // list is used only by the manager page (own + ch_only + public
      // grids). Requires sign-in; the client query scopes the results.
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                       && request.resource.data.ownerUid == request.auth.uid
                       && request.resource.data.visibility in ['public','ch_only','private'];
      // Owner may edit title/description/visibility/updatedAt/sizeBytes.
      // ownerUid, storagePath, createdAt are pinned (immutable).
      allow update: if isSignedIn()
                       && (dashOwner() || isAdmin())
                       && request.resource.data.ownerUid == resource.data.ownerUid
                       && request.resource.data.storagePath == resource.data.storagePath
                       && request.resource.data.visibility in ['public','ch_only','private'];
      allow delete: if isSignedIn() && (dashOwner() || isAdmin());
    }
  }
}
